  { label: "Show recorded videos", action: () => { if (!videosOpen) $("videos-toggle").click(); } },
];
let palSel = 0, palFiltered = PALETTE_CMDS;
function openPalette() {
  $("palette").style.display = "flex";
  $("palette-input").value = ""; palSel = 0; renderPalette();
  $("palette-input").focus();
}
function closePalette() { $("palette").style.display = "none"; }
function renderPalette() {
  const q = $("palette-input").value.toLowerCase();
  palFiltered = PALETTE_CMDS.filter((c) => c.label.toLowerCase().includes(q));
  if (palSel >= palFiltered.length) palSel = 0;
  $("palette-list").innerHTML = palFiltered.map((c, i) =>
    '<div class="palette-item ' + (i === palSel ? "sel" : "") + '" data-i="' + i + '">'
    + esc(c.label) + (c.kind ? '<span class="pk">action</span>' : '<span class="pk">view</span>') + "</div>").join("");
  for (const el of $("palette-list").querySelectorAll(".palette-item"))
    el.addEventListener("click", () => runPalette(parseInt(el.dataset.i, 10)));
}
function runPalette(i) {
  const cmd = palFiltered[i];
  closePalette();
  if (!cmd) return;
  if (cmd.kind) startJob(cmd.kind);
  else if (cmd.action) cmd.action();
}
$("palette-input").addEventListener("input", renderPalette);
$("palette-input").addEventListener("keydown", (ev) => {
  if (ev.key === "ArrowDown") { palSel = Math.min(palSel + 1, palFiltered.length - 1); renderPalette(); ev.preventDefault(); }
  else if (ev.key === "ArrowUp") { palSel = Math.max(palSel - 1, 0); renderPalette(); ev.preventDefault(); }
  else if (ev.key === "Enter") runPalette(palSel);
  else if (ev.key === "Escape") closePalette();
});
$("palette").addEventListener("click", (ev) => { if (ev.target.id === "palette") closePalette(); });

/* sound cue on finish — rising tone on green, falling on red (mutable) */
function beep(ok) {
  if (!soundOn) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = "sine";
    const t = ctx.currentTime;
    o.frequency.setValueAtTime(ok ? 520 : 400, t);
    o.frequency.exponentialRampToValueAtTime(ok ? 780 : 240, t + 0.18);
    g.gain.setValueAtTime(0.14, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
    o.start(t); o.stop(t + 0.36);
  } catch (e) { /* audio unavailable */ }
}

/* confetti on an all-green finish */
function confettiBurst() {
  const canvas = $("confetti"), ctx = canvas.getContext("2d");
  canvas.width = innerWidth; canvas.height = innerHeight; canvas.style.display = "block";
  const colors = ["#22c55e", "#007aff", "#a78bfa", "#f59e0b", "#f0583a"];
  const parts = Array.from({ length: 140 }, () => ({
    x: innerWidth / 2 + (Math.random() - 0.5) * 200, y: innerHeight / 3,
    vx: (Math.random() - 0.5) * 14, vy: Math.random() * -12 - 4,
    c: colors[Math.floor(Math.random() * colors.length)], r: 3 + Math.random() * 4, life: 0,
  }));
  let frame = 0;
  (function anim() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (const p of parts) {
      p.vy += 0.35; p.x += p.vx; p.y += p.vy; p.life++;
      ctx.fillStyle = p.c; ctx.globalAlpha = Math.max(0, 1 - p.life / 90);
      ctx.fillRect(p.x, p.y, p.r, p.r);
    }
    if (++frame < 90) requestAnimationFrame(anim);
    else { ctx.clearRect(0, 0, canvas.width, canvas.height); canvas.style.display = "none"; }
  })();
}

document.addEventListener("keydown", (ev) => {
  if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "k") { ev.preventDefault(); openPalette(); return; }
  if (ev.key === "Escape") { closeDrawer(); closePalette(); }
  if (ev.key === "r" && !ev.metaKey && !ev.ctrlKey && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) sync();
});
