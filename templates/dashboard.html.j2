<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zyvor Mission Control</title>
<style>
  /* macOS Tahoe Liquid Glass — tokens mirrored from hypersdk web/dashboard-react */
  :root {
    color-scheme: dark;
    --radius-liquid: 22px;
    --blur-liquid: 28px;
    --accent: #007aff;
    --surface-base: rgba(28, 28, 30, 0.68);
    --surface-elevated: rgba(36, 36, 38, 0.82);
    --surface-strong: rgba(44, 44, 46, 0.92);
    --surface-muted: rgba(255, 255, 255, 0.04);
    --separator: rgba(255, 255, 255, 0.08);
    --fill-secondary: rgba(255, 255, 255, 0.06);
    --glass-border-strong: rgba(255, 255, 255, 0.12);
    --glass-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
    --glass-highlight: rgba(255, 255, 255, 0.1);
    --text-primary: #f5f5f7;
    --text-secondary: #98989d;
    --text-muted: #636366;
    --status-ok: rgb(48, 209, 88);
    --status-warn: rgb(255, 214, 10);
    --status-error: rgb(255, 69, 58);
    --status-info: rgb(0, 122, 255);
    --status-neutral: rgb(152, 152, 157);
    --font-base: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro', 'Inter', 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
    --font-mono: 'SF Mono', ui-monospace, SFMono-Regular, 'JetBrains Mono', Menlo, monospace;
  }
  * { box-sizing: border-box; }
  html, body { min-height: 100%; }
  body {
    margin: 0;
    background:
      radial-gradient(ellipse 120% 80% at 50% -20%, rgba(30, 58, 95, 0.35), transparent 55%),
      linear-gradient(180deg, rgb(8, 12, 22) 0%, rgb(6, 10, 18) 100%);
    background-attachment: fixed;
    color: var(--text-primary);
    font-family: var(--font-base);
    font-size: 14px; line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 1200px; margin: 0 auto; padding: 24px 28px 60px; }

  .glass {
    background-color: var(--surface-base);
    background-image: linear-gradient(to bottom, var(--glass-highlight), transparent 45%);
    backdrop-filter: blur(var(--blur-liquid)) saturate(1.15);
    -webkit-backdrop-filter: blur(var(--blur-liquid)) saturate(1.15);
    border: 1px solid var(--separator);
    box-shadow: var(--glass-shadow);
    border-radius: var(--radius-liquid);
  }

  /* hero */
  .hero {
    position: relative; overflow: hidden;
    border: 1px solid var(--separator); border-radius: var(--radius-liquid);
    background:
      linear-gradient(135deg, var(--glass-highlight) 0%, transparent 42%),
      linear-gradient(160deg, var(--surface-elevated) 0%, var(--surface-base) 100%);
    backdrop-filter: blur(28px) saturate(1.5);
    -webkit-backdrop-filter: blur(28px) saturate(1.5);
    box-shadow: 0 1px 0 var(--glass-highlight) inset, var(--glass-shadow);
    padding: 22px 24px; margin-bottom: 24px;
  }
  .hero-shine {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.04) 50%, transparent 60%);
  }
  .hero-head { position: relative; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .icon-badge {
    display: flex; align-items: center; justify-content: center;
    width: 3.25rem; height: 3.25rem; border-radius: 1rem; flex: none;
    background: linear-gradient(145deg, rgba(56, 189, 248, 0.22), rgba(99, 102, 241, 0.12));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 24px -8px rgba(14, 165, 233, 0.35);
  }
  .hero h1 { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .hero .subtitle { color: var(--text-secondary); font-size: 13px; margin-top: 2px; }
  .hero .sync { margin-left: auto; color: var(--text-muted); font-size: 12px; }
  .status-line { display: inline-flex; align-items: center; gap: 8px; }
  .status-line .lamp { width: 11px; height: 11px; border-radius: 50%; flex: none; }
  .hero[data-status="go"]       .lamp { background: var(--status-ok); box-shadow: 0 0 14px var(--status-ok); }
  .hero[data-status="go"]       h1 span { color: var(--status-ok); }
  .hero[data-status="degraded"] .lamp { background: var(--status-warn); box-shadow: 0 0 14px var(--status-warn); }
  .hero[data-status="degraded"] h1 span { color: var(--status-warn); }
  .hero[data-status="down"]     .lamp { background: var(--status-error); box-shadow: 0 0 14px var(--status-error); animation: pulse 1.1s infinite; }
  .hero[data-status="down"]     h1 span { color: var(--status-error); }
  .hero[data-status="offline"]  .lamp { background: var(--status-neutral); }
  .hero[data-status="offline"]  h1 span { color: var(--text-secondary); }
  @keyframes pulse { 50% { opacity: 0.35; } }

  .stat-grid { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 18px; }
  .stat-tile {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1rem 1.125rem; border-radius: 1.125rem;
    border: 1px solid var(--separator); background: var(--surface-muted);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--glass-highlight) inset;
  }
  .stat-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-secondary); }
  .stat-value { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .stat-sub { font-size: 0.72rem; color: var(--text-muted); }

  h2 { font-size: 13px; font-weight: 600; color: var(--text-secondary); margin: 26px 0 12px; letter-spacing: -0.01em; }

  .strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .card { padding: 16px 18px; }
  .card .k { color: var(--text-muted); font-size: 12px; font-family: var(--font-mono); }
  .card .v { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; margin-top: 2px; font-variant-numeric: tabular-nums; }
  .card .d { color: var(--text-secondary); font-size: 12px; margin-top: 3px; }

  .pods { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .pod { cursor: pointer; transition: background-color .15s, border-color .15s; }
  .pod:hover { background-color: var(--surface-elevated); border-color: var(--glass-border-strong); }
  .pod .row { display: flex; align-items: center; gap: 9px; }
  .pod .dot { width: 10px; height: 10px; border-radius: 50%; flex: none; animation: pulse 2.4s infinite; }
  .pod .name { font-weight: 600; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pod .phase { margin-left: auto; font-size: 11px; color: var(--text-secondary); white-space: nowrap; }
  .pod .meta { display: flex; gap: 12px; flex-wrap: wrap; color: var(--text-muted); font-size: 12px; margin-top: 10px; }
  .pod .meta b { color: var(--text-secondary); font-weight: 600; font-variant-numeric: tabular-nums; }
  .pod .restarts-bad { color: var(--status-error); font-weight: 700; }
  .pod .warn { color: var(--status-warn); font-size: 12px; margin-top: 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .empty {
    color: var(--text-secondary); padding: 18px 20px;
    border: 1px solid var(--separator); border-radius: var(--radius-liquid);
    background: var(--surface-muted);
  }
  .empty code { font-family: var(--font-mono); color: var(--text-primary); background: var(--fill-secondary); padding: 1px 6px; border-radius: 6px; }

  .qa { display: grid; grid-template-columns: 300px 1fr 300px; gap: 14px; }
  @media (max-width: 1100px) { .qa { grid-template-columns: 300px 1fr; } }
  @media (max-width: 800px) { .qa { grid-template-columns: 1fr; } }
  .spark-wrap { position: relative; }
  .spark-tip {
    position: absolute; pointer-events: none; display: none;
    background: var(--surface-strong); border: 1px solid var(--glass-border-strong); border-radius: 10px;
    backdrop-filter: blur(var(--blur-liquid)); -webkit-backdrop-filter: blur(var(--blur-liquid));
    padding: 4px 10px; font-size: 12px; color: var(--text-primary); white-space: nowrap; z-index: 2;
    box-shadow: var(--glass-shadow);
  }
  .runs-table { width: 100%; border-collapse: collapse; }
  .runs-table tr { transition: background 0.12s ease; }
  .runs-table tr:hover { background: var(--fill-secondary); }
  .runs-table td { padding: 7px 10px; border-bottom: 1px solid var(--separator); font-size: 13px; color: var(--text-secondary); }
  .runs-table td:first-child { color: var(--text-muted); font-size: 12px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .chip {
    display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 9999px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.04);
  }
  .chip.pass { color: var(--status-ok); }
  .chip.fail { color: var(--status-error); }

  .drawer {
    position: fixed; top: 0; right: 0; bottom: 0; width: min(680px, 92vw);
    background-color: var(--surface-strong);
    backdrop-filter: blur(var(--blur-liquid)) saturate(1.25);
    -webkit-backdrop-filter: blur(var(--blur-liquid)) saturate(1.25);
    border-left: 1px solid var(--glass-border-strong);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    transform: translateX(100%); transition: transform .18s ease; z-index: 10;
    display: flex; flex-direction: column;
  }
  .drawer.open { transform: translateX(0); }
  .drawer header { padding: 14px 18px; border-bottom: 1px solid var(--separator); display: flex; align-items: center; }
  .drawer header b { font-family: var(--font-mono); font-size: 13px; }
  .drawer header .close {
    margin-left: auto; cursor: pointer; color: var(--text-secondary);
    background: var(--surface-muted); border: 1px solid var(--separator); border-radius: 9999px;
    width: 28px; height: 28px; font-size: 14px; line-height: 1;
  }
  .drawer header .close:hover { color: var(--text-primary); background: var(--fill-secondary); }
  .drawer pre {
    flex: 1; overflow: auto; margin: 0; padding: 14px 18px;
    font-family: var(--font-mono); font-size: 12px; line-height: 1.6; color: var(--text-secondary);
    white-space: pre-wrap; word-break: break-all;
  }
  .run-btn {
    cursor: pointer; padding: 3px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600;
    color: var(--text-primary); background: var(--surface-muted);
    border: 1px solid var(--separator); font-family: var(--font-base);
    transition: background .15s, border-color .15s;
  }
  .run-btn:hover:not(:disabled) { background: rgba(0, 122, 255, 0.18); border-color: var(--accent); }
  .run-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .run-status { font-size: 12px; font-weight: 400; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 6px; }
  .run-status .spin {
    width: 9px; height: 9px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 8px var(--accent); animation: pulse 1.2s infinite;
  }
  .run-status.err { color: var(--status-error); }
  .acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .act-title { font-weight: 600; font-size: 13px; margin-bottom: 10px; }
  .act-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .act-row:last-child { margin-bottom: 0; }
  .inp {
    background: rgba(255, 255, 255, 0.08); border: 1px solid var(--separator); color: var(--text-primary);
    border-radius: 0.625rem; padding: 5px 10px; font-size: 12px; font-family: var(--font-base);
  }
  .inp:focus { outline: none; border-color: rgba(0, 122, 255, 0.5); box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.18); }
  .inp.grow { flex: 1; min-width: 120px; }
  textarea.inp { resize: vertical; }
  .chk { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-secondary); }
  .chk input { accent-color: var(--accent); }
  .result-title { font-weight: 600; font-size: 13px; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
  .result-files { font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); line-height: 1.7; }
  .result-err { color: var(--status-error); font-size: 13px; }
  .rlink { color: var(--accent); text-decoration: none; font-size: 12px; }
  .rlink:hover { text-decoration: underline; }
  /* toasts */
  #toasts { position: fixed; top: 18px; right: 18px; z-index: 50; display: flex; flex-direction: column; gap: 10px; }
  .toast {
    background-color: var(--surface-strong); border: 1px solid var(--glass-border-strong);
    backdrop-filter: blur(var(--blur-liquid)); -webkit-backdrop-filter: blur(var(--blur-liquid));
    border-radius: 14px; padding: 10px 16px; box-shadow: var(--glass-shadow);
    font-size: 13px; display: flex; align-items: center; gap: 10px; min-width: 240px;
    animation: toast-in .25s ease-out;
  }
  @keyframes toast-in { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
  .toast.ok { border-left: 3px solid var(--status-ok); }
  .toast.bad { border-left: 3px solid var(--status-error); }
  .toast .t-kind { font-weight: 600; }
  .toast .t-sub { color: var(--text-secondary); font-size: 12px; }

  /* activity feed */
  .feed { display: flex; flex-direction: column; gap: 0; max-height: 300px; overflow-y: auto; }
  .feed-item { display: flex; align-items: baseline; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--separator); font-size: 12px; }
  .feed-item:last-child { border-bottom: none; }
  .feed-item .f-when { color: var(--text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .feed-item .f-kind { font-weight: 600; white-space: nowrap; }
  .feed-item .f-brief { color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* pod search */
  .pod-search { margin-left: 10px; width: 190px; font-weight: 400; }

  /* stat trend */
  .trend-up { color: var(--status-ok); }
  .trend-down { color: var(--status-error); }

  /* log drawer controls */
  .drawer-controls { display: flex; align-items: center; gap: 8px; padding: 8px 18px; border-bottom: 1px solid var(--separator); flex-wrap: wrap; }
  .drawer-controls .inp { padding: 3px 8px; font-size: 11px; }
  .drawer-controls .chk { font-size: 11px; }
  .dl-btn {
    cursor: pointer; font-size: 11px; padding: 3px 10px; border-radius: 9999px;
    color: var(--text-secondary); background: var(--surface-muted); border: 1px solid var(--separator);
  }
  .dl-btn:hover { color: var(--text-primary); background: var(--fill-secondary); }

  /* expandable run rows */
  .runs-table tr.expandable { cursor: pointer; }
  .run-detail td {
    background: var(--surface-muted); font-size: 12px; color: var(--text-secondary);
    white-space: pre-wrap; padding: 10px 12px;
  }

  footer { margin-top: 36px; color: var(--text-muted); font-size: 12px; display: flex; gap: 18px; }
  kbd {
    border: 1px solid var(--separator); border-radius: 6px; padding: 0 6px; font-size: 11px;
    font-family: var(--font-mono); background: var(--surface-muted);
  }
</style>
</head>
<body>
<main>
  <div class="hero" data-status="offline" id="hero">
    <div class="hero-shine" aria-hidden="true"></div>
    <div class="hero-head">
      <div class="icon-badge" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <div>
        <div style="font-size:11px;letter-spacing:0.22em;color:var(--text-secondary);font-weight:600">ZYVOR QA · MISSION CONTROL</div>
        <h1><span id="banner-title">STANDBY</span></h1>
        <div class="subtitle status-line"><span class="lamp"></span><span id="banner-sub">waiting for first sync</span></div>
      </div>
      <span class="sync" style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <span id="sync">connecting…</span>
        <span id="session" style="display:none">🔐 <b id="session-user"></b> · <a class="rlink" href="#" id="logout">sign out</a></span>
      </span>
    </div>
    <div class="stat-grid">
      <div class="stat-tile"><span class="stat-label">Pods</span><span class="stat-value" id="stat-pods">—</span><span class="stat-sub" id="stat-pods-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Replicas</span><span class="stat-value" id="stat-replicas">—</span><span class="stat-sub" id="stat-replicas-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Last QA run</span><span class="stat-value" id="stat-run">—</span><span class="stat-sub" id="stat-run-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Pass rate</span><span class="stat-value" id="stat-rate">—</span><span class="stat-sub" id="stat-rate-sub">last 30 runs</span></div>
      <div class="stat-tile"><span class="stat-label">Next smoke run</span><span class="stat-value" id="stat-cron">—</span><span class="stat-sub" id="stat-cron-sub"></span></div>
    </div>
  </div>

  <h2>Workloads</h2>
  <div class="strip" id="workloads"><div class="empty">No workload data yet.</div></div>

  <h2 style="display:flex;align-items:center">Pods <span style="color:var(--text-muted);font-weight:400;margin-left:6px" id="ns"></span>
    <input class="inp pod-search" id="pod-search" placeholder="filter pods…">
    <button class="dl-btn" id="events-toggle" style="margin-left:8px">⚡ events</button>
  </h2>
  <div class="glass card" id="events-panel" style="display:none;margin-bottom:14px">
    <div class="k" style="margin-bottom:8px">Recent cluster events</div>
    <div style="overflow-x:auto"><table class="runs-table" id="events-table"><tbody></tbody></table></div>
  </div>
  <div class="pods" id="pods"><div class="empty">No pod data yet.</div></div>

  <h2 style="display:flex;align-items:center;gap:12px">Actions <span id="run-status" class="run-status"></span></h2>
  <div class="acts">
    <div class="glass card act">
      <div class="act-title">▶ Run tests</div>
      <div class="act-row">
        <select class="inp" id="run-source"><option value="local">local</option><option value="github">github</option></select>
        <input class="inp grow" id="run-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row">
        <input class="inp" id="run-pr" type="number" placeholder="PR #" style="width:80px">
        <label class="chk"><input type="checkbox" id="run-coverage"> expand coverage</label>
      </div>
      <div class="act-row">
        <button class="run-btn act-btn" data-kind="smoke">▶ Smoke</button>
        <button class="run-btn act-btn" data-kind="full">▶ Full pipeline</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">⚙ Generate tests</div>
      <div class="act-row">
        <select class="inp" id="gen-source"><option value="local">local</option><option value="github">github</option></select>
        <input class="inp grow" id="gen-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row"><label class="chk"><input type="checkbox" id="gen-coverage"> expand coverage</label></div>
      <div class="act-row"><button class="run-btn act-btn" data-kind="generate">⚙ Generate</button></div>
    </div>
    <div class="glass card act">
      <div class="act-title">🔎 Discover coverage</div>
      <div class="d" style="margin-bottom:8px">Scan repo code/docs for untested routes and pages.</div>
      <div class="act-row">
        <select class="inp" id="disc-source"><option value="github">github</option><option value="local">local</option></select>
        <button class="run-btn act-btn" data-kind="discover">🔎 Discover</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">✨ Create from English</div>
      <div class="act-row"><textarea class="inp grow" id="nl-desc" rows="2" placeholder="e.g. Verify /vm page mentions KubeVirt migration"></textarea></div>
      <div class="act-row" id="nl-chips" style="gap:6px">
        <span class="chip nl-chip" style="cursor:pointer">homepage shows all products</span>
        <span class="chip nl-chip" style="cursor:pointer">/vm mentions KubeVirt</span>
        <span class="chip nl-chip" style="cursor:pointer">Schedule Demo button works</span>
      </div>
      <div class="act-row">
        <label class="chk"><input type="checkbox" id="nl-execute"> run immediately</label>
        <button class="run-btn act-btn" data-kind="create">✨ Create</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">👁 Visual regression</div>
      <div class="d" style="margin-bottom:8px">Pixel-compare screenshots against baselines.</div>
      <div class="act-row">
        <label class="chk"><input type="checkbox" id="reg-update"> update baselines</label>
        <button class="run-btn act-btn" data-kind="regression">👁 Regression</button>
      </div>
    </div>
    <div class="glass card act" style="grid-column: 1 / -1">
      <div class="act-title">🌐 Test any site — crawl every page and validate it</div>
      <div class="act-row">
        <input class="inp grow" id="ct-url" placeholder="https://your-app.example.com (any UX — self-signed TLS OK)">
        <input class="inp" id="ct-pages" type="number" value="30" min="1" max="200" style="width:90px" title="max pages">
      </div>
      <div class="act-row">
        <input class="inp grow" id="ct-user" placeholder="login username (optional)" autocomplete="off">
        <input class="inp grow" id="ct-pass" type="password" placeholder="login password (optional)" autocomplete="off">
        <label class="chk"><input type="checkbox" id="ct-insecure"> allow self-signed TLS</label>
        <button class="run-btn act-btn" data-kind="crawl_test">🌐 Crawl &amp; test all pages</button>
      </div>
    </div>
  </div>
  <div class="glass card" id="job-result" style="display:none;margin-top:14px"></div>

  <datalist id="spec-list"></datalist>

  <h2 style="display:flex;align-items:center;gap:10px">QA Runs
    <a class="dl-btn" href="/api/dashboard/runs?limit=200" download="qa-runs.json" style="text-decoration:none">⬇ export</a>
  </h2>
  <div class="qa">
    <div class="glass card">
      <div class="k">Latest run
        <a class="rlink" id="report-link" href="/reports/qa-summary.html" target="_blank" style="display:none">📄 report</a>
        <a class="rlink" id="pdf-link" href="/reports/qa-summary.pdf" target="_blank" style="display:none">📑 pdf</a>
      </div>
      <div class="v" id="latest-run">—</div>
      <div class="d" id="latest-run-detail"></div>
      <div class="spark-wrap" style="margin-top:12px">
        <svg id="spark" width="100%" height="46" viewBox="0 0 268 46" preserveAspectRatio="none" role="img" aria-label="Pass rate, last 30 runs"></svg>
        <div class="spark-tip" id="spark-tip"></div>
      </div>
      <div class="k" style="margin-top:6px">Pass rate, last 30 runs</div>
    </div>
    <div class="glass card">
      <table class="runs-table" id="runs-table" aria-label="Recent QA runs"><tbody></tbody></table>
      <div class="empty" id="runs-empty" style="border:none;background:none">No run history yet — run <code>zyvor-qa run</code> once.</div>
    </div>
    <div class="glass card">
      <div class="k" style="margin-bottom:8px">Activity</div>
      <div class="feed" id="feed"><span class="d">No activity yet this session.</span></div>
    </div>
  </div>

  <footer>
    <span><kbd>r</kbd> refresh</span>
    <span><kbd>esc</kbd> close logs</span>
    <span>auto-refresh
      <select class="inp" id="refresh-rate" style="padding:1px 6px;font-size:11px">
        <option value="5000">5s</option>
        <option value="15000">15s</option>
        <option value="60000">60s</option>
        <option value="0">paused</option>
      </select>
    </span>
    <span id="server-info" style="margin-left:auto"></span>
  </footer>
</main>

<aside class="drawer" id="drawer" aria-label="Pod logs">
  <header>
    <b id="drawer-title">logs</b>
    <button class="close" id="drawer-close" aria-label="Close">✕</button>
  </header>
  <div class="drawer-controls">
    <select class="inp" id="drawer-container"><option value="">all containers</option></select>
    <select class="inp" id="drawer-lines">
      <option value="100">100 lines</option>
      <option value="500">500 lines</option>
      <option value="1000">1000 lines</option>
    </select>
    <label class="chk"><input type="checkbox" id="drawer-follow" checked> follow</label>
    <button class="dl-btn" id="drawer-download">⬇ download</button>
    <span class="d" style="font-size:11px;margin-left:auto">hover pauses refresh</span>
  </div>
  <pre id="drawer-body">…</pre>
</aside>

<div id="toasts" aria-live="polite"></div>

<script>
"use strict";
const REFRESH = {{ refresh_interval_ms }};
const $ = (id) => document.getElementById(id);
let lastSync = null;
let drawerPod = null;
let drawerHover = false;

function esc(s) {
  return String(s ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function rel(seconds) {
  if (seconds == null) return "—";
  if (seconds < 90) return seconds + "s";
  if (seconds < 5400) return Math.round(seconds / 60) + "m";
  if (seconds < 172800) return Math.round(seconds / 3600) + "h";
  return Math.round(seconds / 86400) + "d";
}
function relIso(iso) {
  if (!iso) return "—";
  return rel(Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000 | 0)) + " ago";
}
function tspan(iso) {
  return '<span title="' + esc(iso || "") + '">' + relIso(iso) + "</span>";
}
function fmtMem(bytes) {
  if (bytes == null) return null;
  if (bytes >= 1024 ** 3) return (bytes / 1024 ** 3).toFixed(1) + "Gi";
  return Math.round(bytes / 1024 ** 2) + "Mi";
}
function fmtCpu(m) {
  if (m == null) return null;
  return m >= 1000 ? (m / 1000).toFixed(1) + " cpu" : Math.round(m) + "m";
}
function toast(kind, ok, sub) {
  const host = $("toasts");
  const el = document.createElement("div");
  el.className = "toast " + (ok ? "ok" : "bad");
  el.innerHTML = "<span>" + (ok ? "✅" : "❌") + '</span><span><span class="t-kind">' + esc(kind) + "</span><br><span class=\"t-sub\">" + esc(sub) + "</span></span>";
  host.appendChild(el);
  setTimeout(() => el.remove(), 7000);
}

/* minimal 5-field cron "next fire" — supports *, numbers, lists, and steps */
function cronNext(expr) {
  const parts = (expr || "").trim().split(/\s+/);
  if (parts.length !== 5) return null;
  const parse = (f, min, max) => {
    const out = new Set();
    for (const piece of f.split(",")) {
      const m = piece.match(/^(\*|\d+)(?:\/(\d+))?$/);
      if (!m) return null;
      const step = m[2] ? parseInt(m[2], 10) : 1;
      const start = m[1] === "*" ? min : parseInt(m[1], 10);
      const end = m[1] === "*" ? max : (m[2] ? max : start);
      for (let v = start; v <= end; v += step) out.add(v);
    }
    return out;
  };
  const fields = [parse(parts[0],0,59), parse(parts[1],0,23), parse(parts[2],1,31), parse(parts[3],1,12), parse(parts[4],0,6)];
  if (fields.some(f => !f)) return null;
  const t = new Date(); t.setUTCSeconds(0, 0); t.setUTCMinutes(t.getUTCMinutes() + 1);
  for (let i = 0; i < 366 * 24 * 60; i++) {
    if (fields[0].has(t.getUTCMinutes()) && fields[1].has(t.getUTCHours()) &&
        fields[2].has(t.getUTCDate()) && fields[3].has(t.getUTCMonth() + 1) &&
        fields[4].has(t.getUTCDay())) return t;
    t.setUTCMinutes(t.getUTCMinutes() + 1);
  }
  return null;
}
function countdown(expr) {
  const next = cronNext(expr);
  if (!next) return null;
  const s = Math.max(0, (next.getTime() - Date.now()) / 1000 | 0);
  const h = s / 3600 | 0, m = (s % 3600) / 60 | 0;
  return h > 0 ? h + "h " + m + "m" : m + "m";
}

function podStatus(p) {
  const phase = p.phase || "Unknown";
  if (phase === "Succeeded") return { color: "var(--status-ok)", label: "Succeeded" };
  if (phase === "Failed") return { color: "var(--status-error)", label: "Failed" };
  if (phase === "Pending") return { color: "var(--status-info)", label: "Pending" };
  if (phase === "Running" && p.total && p.ready < p.total) return { color: "var(--status-warn)", label: "Running (not ready)" };
  if (phase === "Running") return { color: "var(--status-ok)", label: "Running" };
  return { color: "var(--status-warn)", label: phase };
}

/* dynamic favicon + tab title reflecting status */
const STATUS_DOT = { go: "#22c55e", degraded: "#f59e0b", down: "#ef4444", offline: "#8e8e93" };
function setFavicon(status) {
  const canvas = document.createElement("canvas");
  canvas.width = canvas.height = 32;
  const ctx = canvas.getContext("2d");
  ctx.fillStyle = STATUS_DOT[status] || STATUS_DOT.offline;
  ctx.beginPath(); ctx.arc(16, 16, 11, 0, Math.PI * 2); ctx.fill();
  let link = document.querySelector('link[rel="icon"]');
  if (!link) { link = document.createElement("link"); link.rel = "icon"; document.head.appendChild(link); }
  link.href = canvas.toDataURL("image/png");
}

function renderHero(overview, pods, runs) {
  const hero = $("hero");
  const status = overview.status || "offline";
  hero.dataset.status = status;
  const titles = { go: "ALL SYSTEMS GO", degraded: "DEGRADED", down: "SYSTEMS DOWN", offline: "CLUSTER OFFLINE" };
  $("banner-title").textContent = titles[status] || status.toUpperCase();
  setFavicon(status);
  document.title = (status === "go" ? "🟢" : status === "degraded" ? "🟡" : status === "down" ? "🔴" : "⚪")
    + " " + (titles[status] || status) + " · Zyvor QA";
  if (overview.server) {
    $("server-info").innerHTML = "zyvor-qa v" + esc(overview.server.version)
      + ' · up <span title="' + esc(overview.server.started_at) + '">'
      + rel(Math.max(0, (Date.now() - new Date(overview.server.started_at).getTime()) / 1000 | 0)) + "</span>";
  }
  $("banner-sub").textContent = overview.cluster && overview.cluster.available
    ? "Kubernetes connected · namespace " + overview.namespace
    : "no Kubernetes API — QA history only";
  $("ns").textContent = overview.namespace ? "· ns/" + overview.namespace : "";

  const podList = (pods && pods.available && pods.pods) || [];
  const healthy = podList.filter((p) => p.phase === "Running" && (!p.total || p.ready >= p.total)).length;
  $("stat-pods").textContent = pods && pods.available ? String(podList.length) : "—";
  $("stat-pods-sub").textContent = pods && pods.available ? healthy + " healthy" : "cluster offline";

  const deps = (overview.workloads && overview.workloads.deployments) || [];
  const ready = deps.reduce((a, d) => a + d.ready, 0);
  const desired = deps.reduce((a, d) => a + d.desired, 0);
  $("stat-replicas").textContent = deps.length ? ready + "/" + desired : "—";
  $("stat-replicas-sub").textContent = deps.length ? deps.length + " deployment" + (deps.length === 1 ? "" : "s") : "cluster offline";

  const latest = runs && runs[0];
  $("stat-run").textContent = latest ? latest.passed + "/" + latest.total : "—";
  $("stat-run").style.color = latest ? (latest.failed > 0 ? "var(--status-error)" : "var(--status-ok)") : "";
  $("stat-run-sub").textContent = latest ? relIso(latest.timestamp) : "no history";

  // pass rate over history + trend vs the older half
  const rated = (runs || []).filter((r) => r.total > 0);
  if (rated.length) {
    const rate = (list) => list.reduce((a, r) => a + r.passed / r.total, 0) / list.length;
    const overall = rate(rated) * 100;
    const half = Math.ceil(rated.length / 2);
    const newer = rate(rated.slice(0, half)) * 100;
    const older = rated.length > half ? rate(rated.slice(half)) * 100 : newer;
    const delta = newer - older;
    const arrow = Math.abs(delta) < 0.5 ? "" : delta > 0 ? ' <span class="trend-up">↑</span>' : ' <span class="trend-down">↓</span>';
    $("stat-rate").innerHTML = overall.toFixed(0) + "%" + arrow;
    $("stat-rate").style.color = overall >= 99 ? "var(--status-ok)" : overall >= 90 ? "" : "var(--status-warn)";
    $("stat-rate-sub").textContent = "last " + rated.length + " run" + (rated.length === 1 ? "" : "s");
  } else {
    $("stat-rate").textContent = "—";
  }

  const crons = (overview.workloads && overview.workloads.cronjobs) || [];
  const active = crons.find((c) => !c.suspend);
  const cd = active ? countdown(active.schedule) : null;
  $("stat-cron").textContent = cd ? "in " + cd : (active ? active.schedule : "—");
  $("stat-cron-sub").textContent = active ? "cron/" + active.name : "no cronjobs";
}

function renderWorkloads(w) {
  const el = $("workloads");
  if (!w || !w.available || (!w.deployments.length && !w.cronjobs.length)) {
    el.innerHTML = '<div class="empty">No workload data (cluster offline or empty namespace).</div>';
    return;
  }
  let html = "";
  for (const d of w.deployments) {
    const ok = d.ready >= d.desired && d.desired > 0;
    html += '<div class="glass card"><div class="k">deploy/' + esc(d.name) + '</div>'
      + '<div class="v" style="color:' + (ok ? "var(--status-ok)" : "var(--status-warn)") + '">' + d.ready + "/" + d.desired + '</div>'
      + '<div class="d">replicas ready</div></div>';
  }
  for (const c of w.cronjobs) {
    const cd = c.suspend ? null : countdown(c.schedule);
    html += '<div class="glass card"><div class="k">cron/' + esc(c.name) + '</div>'
      + '<div class="v">' + (c.suspend ? "suspended" : (cd ? "in " + cd : esc(c.schedule))) + '</div>'
      + '<div class="d">' + esc(c.schedule) + ' · last: ' + relIso(c.last_schedule)
      + (c.active ? ' · <b style="color:var(--status-warn)">running now</b>' : "") + '</div></div>';
  }
  el.innerHTML = html;
}

let podsCache = null;
function renderPods(data) {
  podsCache = data;
  const el = $("pods");
  if (!data.available) {
    el.innerHTML = '<div class="empty">Kubernetes API unreachable — start a cluster or set KUBECONFIG. '
      + 'The QA runs panel below still works.</div>';
    return;
  }
  const filter = $("pod-search").value.trim().toLowerCase();
  const pods = data.pods.filter((p) =>
    !filter || [p.name, p.node, p.phase, (p.images || []).join(" ")].join(" ").toLowerCase().includes(filter));
  if (!pods.length) {
    el.innerHTML = '<div class="empty">' + (filter ? "No pods match “" + esc(filter) + "”." : "No pods in namespace " + esc(data.namespace) + ".") + "</div>";
    return;
  }
  el.innerHTML = pods.map((p) => {
    const st = podStatus(p);
    const image = (p.images && p.images[0] || "").split("/").pop();
    const cpu = p.usage ? fmtCpu(p.usage.cpu_millicores) : null;
    const mem = p.usage ? fmtMem(p.usage.memory_bytes) : null;
    return '<div class="glass card pod" data-pod="' + esc(p.name) + '" title="click for logs">'
      + '<div class="row"><span class="dot" style="background:' + st.color + ';box-shadow:0 0 8px ' + st.color + '"></span>'
      + '<span class="name">' + esc(p.name) + '</span>'
      + '<span class="phase">' + esc(st.label) + '</span></div>'
      + '<div class="meta">'
      + '<span>ready <b>' + p.ready + "/" + p.total + '</b></span>'
      + '<span class="' + (p.restarts > 0 ? "restarts-bad" : "") + '">restarts <b>' + p.restarts + '</b></span>'
      + '<span>age <b>' + rel(p.age_seconds) + '</b></span>'
      + (cpu ? '<span>cpu <b>' + cpu + '</b></span>' : "")
      + (mem ? '<span>mem <b>' + mem + '</b></span>' : "")
      + (p.node ? '<span>node <b>' + esc(p.node) + '</b></span>' : "")
      + (image ? '<span><b>' + esc(image) + '</b></span>' : "")
      + '</div>'
      + (p.warnings && p.warnings.length ? '<div class="warn" title="' + esc(p.warnings.join("\n")) + '">⚠ ' + esc(p.warnings[p.warnings.length - 1]) + '</div>' : "")
      + '<div class="meta" style="margin-top:8px"><button class="dl-btn pod-restart" data-pod="' + esc(p.name) + '">⟳ restart</button></div>'
      + '</div>';
  }).join("");
  for (const card of el.querySelectorAll(".pod")) {
    card.addEventListener("click", () => openDrawer(card.dataset.pod));
  }
  for (const btn of el.querySelectorAll(".pod-restart")) {
    btn.addEventListener("click", async (ev) => {
      ev.stopPropagation();
      const pod = btn.dataset.pod;
      if (!confirm("Restart pod " + pod + "? Its controller will recreate it.")) return;
      const res = await fetch("/api/dashboard/pods/" + encodeURIComponent(pod), { method: "DELETE" });
      const data = await res.json();
      toast("restart pod", !!data.ok, data.ok ? pod + " deleted — recreating" : (data.error || "failed"));
      sync();
    });
  }
}
$("pod-search").addEventListener("input", () => { if (podsCache) renderPods(podsCache); });

/* cluster events panel */
let eventsOpen = false;
$("events-toggle").addEventListener("click", async () => {
  eventsOpen = !eventsOpen;
  $("events-panel").style.display = eventsOpen ? "block" : "none";
  if (eventsOpen) await loadEvents();
});
async function loadEvents() {
  try {
    const data = await fetch("/api/dashboard/events").then((r) => r.json());
    const tbody = $("events-table").querySelector("tbody");
    if (!data.available || !data.events.length) {
      tbody.innerHTML = '<tr><td colspan="5">' + (data.available ? "No recent events." : "Cluster unavailable.") + "</td></tr>";
      return;
    }
    tbody.innerHTML = data.events.map((e) =>
      "<tr><td>" + tspan(e.at) + '</td>'
      + '<td><span class="chip ' + (e.type === "Warning" ? "fail" : "pass") + '">' + esc(e.type) + "</span></td>"
      + "<td>" + esc(e.reason) + (e.count > 1 ? " ×" + e.count : "") + "</td>"
      + "<td>" + esc(e.object) + "</td>"
      + '<td style="max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + esc(e.message) + '">' + esc(e.message) + "</td></tr>"
    ).join("");
  } catch (err) {
    $("events-table").querySelector("tbody").innerHTML = "<tr><td>failed: " + esc(String(err)) + "</td></tr>";
  }
}

/* NL example chips + sticky action inputs */
for (const chip of document.querySelectorAll(".nl-chip")) {
  chip.addEventListener("click", () => { $("nl-desc").value = chip.textContent; });
}
const STICKY = ["run-source", "run-spec", "gen-source", "gen-spec", "disc-source", "ct-url", "ct-user", "ct-pages"];
for (const id of STICKY) {
  const el = $(id);
  const saved = localStorage.getItem("zyvor-" + id);
  if (saved !== null) el.value = saved;
  el.addEventListener("change", () => localStorage.setItem("zyvor-" + id, el.value));
}

/* spec-path autocomplete */
fetch("/api/dashboard/specs").then((r) => r.json()).then((d) => {
  $("spec-list").innerHTML = (d.specs || []).map((s) => '<option value="' + esc(s) + '">').join("");
}).catch(() => {});

function renderRuns(runs) {
  $("runs-empty").style.display = runs.length ? "none" : "block";
  if (runs.length) {
    const latest = runs[0];
    $("latest-run").textContent = latest.passed + "/" + latest.total + " passed";
    $("latest-run").style.color = latest.failed > 0 ? "var(--status-error)" : "var(--status-ok)";
    $("latest-run-detail").textContent = relIso(latest.timestamp) + " · source: " + latest.source;
  }
  $("runs-table").querySelector("tbody").innerHTML = runs.slice(0, 12).map((r, i) =>
    '<tr class="expandable" data-i="' + i + '" title="click for details"><td>' + tspan(r.timestamp) + '</td>'
    + '<td><span class="chip ' + (r.failed > 0 ? "fail" : "pass") + '">' + (r.failed > 0 ? "FAIL" : "PASS") + '</span></td>'
    + '<td>' + r.passed + "/" + r.total + ' passed</td>'
    + '<td>' + (r.duration_s != null ? rel(r.duration_s | 0) : "—") + '</td>'
    + '<td>' + esc(r.source) + '</td></tr>'
    + '<tr class="run-detail" style="display:none"><td colspan="5">' + esc(r.summary || "(no summary)") + '</td></tr>'
  ).join("");
  for (const row of $("runs-table").querySelectorAll("tr.expandable")) {
    row.addEventListener("click", () => {
      const detail = row.nextElementSibling;
      detail.style.display = detail.style.display === "none" ? "" : "none";
    });
  }
  renderSpark(runs);
}

/* single-series pass-rate sparkline with hover tooltip (accent blue) */
function renderSpark(runs) {
  const svg = $("spark");
  const pts = runs.slice(0, 30).reverse()
    .map((r) => ({ rate: r.total ? r.passed / r.total : 0, run: r }));
  if (pts.length < 2) { svg.innerHTML = ""; return; }
  const W = 268, H = 46, PAD = 3;
  const x = (i) => PAD + (i / (pts.length - 1)) * (W - 2 * PAD);
  const y = (rate) => H - PAD - rate * (H - 2 * PAD);
  const path = pts.map((p, i) => (i ? "L" : "M") + x(i).toFixed(1) + " " + y(p.rate).toFixed(1)).join(" ");
  const area = path + " L" + x(pts.length - 1).toFixed(1) + " " + (H - PAD) + " L" + x(0).toFixed(1) + " " + (H - PAD) + " Z";
  const last = pts[pts.length - 1];
  svg.innerHTML =
    '<defs><linearGradient id="sparkfill" x1="0" y1="0" x2="0" y2="1">'
    + '<stop offset="0%" stop-color="rgba(0,122,255,0.28)"/><stop offset="100%" stop-color="rgba(0,122,255,0)"/>'
    + '</linearGradient></defs>'
    + '<line x1="' + PAD + '" y1="' + y(1) + '" x2="' + (W - PAD) + '" y2="' + y(1) + '" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>'
    + '<path d="' + area + '" fill="url(#sparkfill)" stroke="none"/>'
    + '<path d="' + path + '" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>'
    + '<circle cx="' + x(pts.length - 1) + '" cy="' + y(last.rate) + '" r="3.5" fill="var(--accent)" stroke="rgb(28,28,30)" stroke-width="2"/>'
    + '<line id="spark-cross" y1="' + PAD + '" y2="' + (H - PAD) + '" stroke="var(--text-muted)" stroke-width="1" style="display:none"/>'
    + '<circle id="spark-dot" r="3.5" fill="var(--accent)" stroke="rgb(28,28,30)" stroke-width="2" style="display:none"/>';
  svg.onmousemove = (ev) => {
    const rect = svg.getBoundingClientRect();
    const i = Math.max(0, Math.min(pts.length - 1, Math.round(((ev.clientX - rect.left) / rect.width) * (pts.length - 1))));
    const p = pts[i];
    const cross = $("spark-cross"), dot = $("spark-dot"), tip = $("spark-tip");
    cross.setAttribute("x1", x(i)); cross.setAttribute("x2", x(i)); cross.style.display = "";
    dot.setAttribute("cx", x(i)); dot.setAttribute("cy", y(p.rate)); dot.style.display = "";
    tip.style.display = "block";
    tip.textContent = relIso(p.run.timestamp) + " — " + p.run.passed + "/" + p.run.total + " passed";
    const px = (x(i) / W) * rect.width;
    tip.style.left = Math.min(rect.width - 150, Math.max(0, px + 8)) + "px";
    tip.style.top = "-8px";
  };
  svg.onmouseleave = () => {
    $("spark-cross").style.display = "none";
    $("spark-dot").style.display = "none";
    $("spark-tip").style.display = "none";
  };
}

async function openDrawer(pod) {
  drawerPod = pod;
  $("drawer-title").textContent = "logs — " + pod;
  $("drawer-body").textContent = "loading…";
  $("drawer-container").innerHTML = '<option value="">all containers</option>';
  $("drawer").classList.add("open");
  await refreshDrawer(true);
}
async function refreshDrawer(force) {
  if (!drawerPod || (drawerHover && !force)) return;
  try {
    const lines = $("drawer-lines").value;
    const container = $("drawer-container").value;
    const url = "/api/dashboard/pods/" + encodeURIComponent(drawerPod) + "/logs?lines=" + lines
      + (container ? "&container=" + encodeURIComponent(container) : "");
    const res = await fetch(url);
    const data = await res.json();
    $("drawer-body").textContent = data.available
      ? (data.lines.join("\n") || "(no log output)")
      : "logs unavailable: " + (data.error || "cluster offline");
    if (data.containers && data.containers.length > 1 && $("drawer-container").options.length <= 1) {
      for (const c of data.containers) {
        const opt = document.createElement("option");
        opt.value = c; opt.textContent = c;
        $("drawer-container").appendChild(opt);
      }
    }
    if ($("drawer-follow").checked) {
      const body = $("drawer-body");
      body.scrollTop = body.scrollHeight;
    }
  } catch (err) {
    $("drawer-body").textContent = "failed to fetch logs: " + err;
  }
}
$("drawer-lines").addEventListener("change", () => refreshDrawer(true));
$("drawer-container").addEventListener("change", () => refreshDrawer(true));
$("drawer-download").addEventListener("click", () => {
  const blob = new Blob([$("drawer-body").textContent], { type: "text/plain" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = (drawerPod || "pod") + ".log";
  a.click();
  URL.revokeObjectURL(a.href);
});
function closeDrawer() {
  drawerPod = null;
  $("drawer").classList.remove("open");
}
$("drawer-close").addEventListener("click", closeDrawer);
$("drawer").addEventListener("mouseenter", () => { drawerHover = true; });
$("drawer").addEventListener("mouseleave", () => { drawerHover = false; });
document.addEventListener("keydown", (ev) => {
  if (ev.key === "Escape") closeDrawer();
  if (ev.key === "r" && !ev.metaKey && !ev.ctrlKey && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) sync();
});
$("logout").addEventListener("click", async (ev) => {
  ev.preventDefault();
  await fetch("/api/logout", { method: "POST" });
  location.href = "/login";
});

/* job triggers — every CLI capability, online */
function jobParams(kind) {
  if (kind === "smoke") return {};
  if (kind === "full") return {
    source: $("run-source").value,
    spec: $("run-spec").value.trim(),
    pr_number: $("run-pr").value ? parseInt($("run-pr").value, 10) : null,
    expand_coverage: $("run-coverage").checked,
  };
  if (kind === "generate") return {
    source: $("gen-source").value,
    spec: $("gen-spec").value.trim(),
    expand_coverage: $("gen-coverage").checked,
  };
  if (kind === "discover") return { source: $("disc-source").value };
  if (kind === "create") return { description: $("nl-desc").value.trim(), execute: $("nl-execute").checked };
  if (kind === "regression") return { update_baselines: $("reg-update").checked };
  if (kind === "crawl_test") return {
    url: $("ct-url").value.trim(),
    username: $("ct-user").value.trim(),
    password: $("ct-pass").value,
    insecure: $("ct-insecure").checked,
    max_pages: parseInt($("ct-pages").value, 10) || 30,
  };
  return {};
}

async function startJob(kind) {
  const el = $("run-status");
  el.classList.remove("err");
  if (kind === "regression" && $("reg-update").checked
      && !confirm("Update baselines? Current screenshots become the new reference.")) return;
  try {
    const res = await fetch("/api/dashboard/jobs", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ kind, params: jobParams(kind) }),
    });
    if (res.status === 409) { el.textContent = "a job is already in progress"; return; }
    if (res.status === 400 || res.status === 422) {
      const data = await res.json();
      el.classList.add("err");
      el.textContent = String(data.detail || "invalid request").slice(0, 90);
      return;
    }
    $("job-result").style.display = "none";
    await sync();
  } catch (err) {
    el.classList.add("err");
    el.textContent = "trigger failed: " + err;
  }
}
for (const btn of document.querySelectorAll(".act-btn")) {
  btn.addEventListener("click", () => startJob(btn.dataset.kind));
}

const KIND_LABELS = { smoke: "smoke tests", full: "full pipeline", generate: "generate", discover: "discover", create: "NL create", regression: "regression", crawl_test: "crawl & test" };

let lastToastKey = "";
function renderRunStatus(st) {
  const el = $("run-status");
  const busy = !!(st && st.running);
  for (const btn of document.querySelectorAll(".act-btn")) btn.disabled = busy;
  if (busy) {
    const secs = st.started_at ? Math.max(0, (Date.now() - new Date(st.started_at).getTime()) / 1000 | 0) : 0;
    el.classList.remove("err");
    el.innerHTML = '<span class="spin"></span>' + esc(KIND_LABELS[st.kind] || st.kind) + " running · " + rel(secs);
  } else if (st && st.error) {
    el.classList.add("err");
    el.textContent = (KIND_LABELS[st.kind] || "job") + " failed: " + st.error.slice(0, 90);
  } else {
    el.classList.remove("err");
    el.textContent = "";
  }

  // toast once per completed job (skip page-load backfill)
  if (st && !st.running && st.finished_at) {
    const key = st.finished_at + (st.kind || "");
    if (lastToastKey && key !== lastToastKey) {
      const r = st.result || {};
      toast(KIND_LABELS[st.kind] || st.kind, !st.error,
        st.error ? st.error.slice(0, 80)
        : (r.total != null ? r.passed + "/" + r.total + " passed" : "completed"));
    }
    lastToastKey = key;
  } else if (st && !st.finished_at && !lastToastKey) {
    lastToastKey = "init";
  }

  renderFeed(st && st.recent);
  renderJobResult(st);
}

function renderFeed(items) {
  if (!items) return;
  const el = $("feed");
  if (!items.length) {
    el.innerHTML = '<span class="d">No activity yet this session.</span>';
    return;
  }
  el.innerHTML = items.map((it) => {
    if (it.type === "webhook") {
      return '<div class="feed-item"><span class="f-when">' + relIso(it.at) + '</span>'
        + '<span class="f-kind">🪝 ' + esc(it.event) + '</span>'
        + '<span class="f-brief">' + esc((it.repo || "") + (it.detail ? " · " + it.detail : "")) + "</span></div>";
    }
    return '<div class="feed-item"><span class="f-when">' + relIso(it.at) + '</span>'
      + '<span class="f-kind">' + (it.ok ? "✅" : "❌") + " " + esc(KIND_LABELS[it.kind] || it.kind) + '</span>'
      + '<span class="f-brief">' + esc(it.brief) + " · " + rel(it.duration_s | 0) + "</span></div>";
  }).join("");
}

let lastResultKey = "";
function renderJobResult(st) {
  const panel = $("job-result");
  if (!st || st.running || (!st.result && !st.error)) return;
  const key = (st.finished_at || "") + (st.kind || "");
  if (key === lastResultKey && panel.style.display !== "none") return;
  lastResultKey = key;
  const r = st.result || {};
  let dur = "";
  if (st.started_at && st.finished_at) {
    dur = ' <span class="d" style="font-weight:400">· took ' + rel(Math.max(0, (new Date(st.finished_at) - new Date(st.started_at)) / 1000 | 0)) + "</span>";
  }
  let html = '<div class="result-title">' + esc(KIND_LABELS[st.kind] || st.kind) + " result" + dur + "</div>";

  if (st.error) {
    html += '<div class="result-err">' + esc(st.error) + "</div>";
  } else if (st.kind === "discover") {
    html += '<div class="d">' + r.inventory + " candidates · " + r.gaps_total + " gaps · " + r.files_scanned + " files scanned</div>";
    if (r.gaps && r.gaps.length) {
      html += '<table class="runs-table" style="margin-top:8px"><tbody>'
        + r.gaps.map((g) => "<tr><td>" + esc(g.kind) + "</td><td>" + esc(g.path) + "</td><td>" + esc(g.title) + "</td><td>" + esc(g.priority) + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else if (st.kind === "generate" || st.kind === "create") {
    const files = r.generated || [];
    html += '<div class="d">' + files.length + " test file(s) generated"
      + (r.requirements != null ? " from " + r.requirements + " requirement(s)" : "")
      + (r.total != null ? " · executed: " + r.passed + "/" + r.total + " passed" : "") + "</div>";
    html += '<div class="result-files" style="margin-top:6px">' + files.map(esc).join("<br>") + "</div>";
  } else if (st.kind === "crawl_test") {
    html += '<div class="d">' + esc(r.url) + " — " + r.pages_found + " page(s) found · "
      + r.passed + "/" + r.total + " passed</div>";
    if (r.failed_pages && r.failed_pages.length) {
      html += '<table class="runs-table" style="margin-top:8px"><tbody>'
        + r.failed_pages.map((f) => '<tr><td><span class="chip fail">FAIL</span></td><td>' + esc(f.title) + "</td><td>" + esc(f.error) + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else if (st.kind === "regression") {
    html += '<div class="d">' + (r.baselines_updated ? "baselines updated · " : "") + (r.diffs || []).length + " screenshot(s) compared</div>";
    if (r.diffs && r.diffs.length) {
      html += '<table class="runs-table" style="margin-top:8px"><tbody>'
        + r.diffs.map((d) => "<tr><td>" + esc(d.file) + '</td><td><span class="chip ' + (d.status === "fail" ? "fail" : "pass") + '">' + esc(d.status) + "</span></td><td>" + (d.diff_percent ?? 0) + "%</td><td>"
          + (d.diff_href ? '<a class="rlink" href="' + esc(d.diff_href) + '" target="_blank">diff image</a>' : esc(d.message || "")) + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else {
    html += '<div class="d">' + r.passed + "/" + r.total + " passed"
      + (r.report ? ' · <a class="rlink" href="' + esc(r.report) + '" target="_blank">📄 open report</a>' : "") + "</div>";
    if (r.generated && r.generated.length) {
      html += '<div class="result-files" style="margin-top:6px">' + r.generated.map(esc).join("<br>") + "</div>";
    }
  }
  panel.innerHTML = html;
  panel.style.display = "block";
}

async function sync() {
  try {
    const [overview, pods, runs, runSt] = await Promise.all([
      fetch("/api/dashboard/overview").then((r) => r.json()),
      fetch("/api/dashboard/pods").then((r) => r.json()),
      fetch("/api/dashboard/runs").then((r) => r.json()),
      fetch("/api/dashboard/jobs/status").then((r) => r.json()),
    ]);
    const runList = runs.runs || [];
    renderHero(overview, pods, runList);
    renderWorkloads(overview.workloads);
    renderPods(pods);
    renderRuns(runList);
    renderRunStatus(runSt);
    $("report-link").style.display = overview.report_available ? "inline" : "none";
    $("pdf-link").style.display = overview.pdf_available ? "inline" : "none";
    if (overview.auth && overview.auth.enabled) {
      $("session").style.display = "inline";
      $("session-user").textContent = overview.auth.user;
    }
    await refreshDrawer();
    lastSync = Date.now();
  } catch (err) {
    $("sync").textContent = "sync failed: " + err;
  }
}
setInterval(() => {
  if (lastSync) $("sync").textContent = "synced " + rel((Date.now() - lastSync) / 1000 | 0) + " ago";
}, 1000);

let refreshTimer = null;
function setRefreshRate(ms) {
  if (refreshTimer) clearInterval(refreshTimer);
  refreshTimer = ms > 0 ? setInterval(() => { sync(); if (eventsOpen) loadEvents(); }, ms) : null;
}
$("refresh-rate").value = String(localStorage.getItem("zyvor-refresh") || REFRESH);
$("refresh-rate").addEventListener("change", () => {
  localStorage.setItem("zyvor-refresh", $("refresh-rate").value);
  setRefreshRate(parseInt($("refresh-rate").value, 10));
});
sync();
setRefreshRate(parseInt($("refresh-rate").value, 10) || REFRESH);
</script>
</body>
</html>
