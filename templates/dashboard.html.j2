/* schedules — recurring monitors */
async function loadSchedules() {
  try {
    const data = await fetch("/api/dashboard/schedules").then((r) => r.json());
    const el = $("schedules");
    if (!data.schedules.length) {
      el.innerHTML = '<span class="d">No schedules — add one to monitor on a loop.</span>';
      return;
    }
    el.innerHTML = data.schedules.map((s) =>
      '<div class="feed-item"><span class="f-kind">🔁 ' + esc(KIND_LABELS[s.kind] || s.kind) + "</span>"
      + '<span class="f-brief">every ' + rel(s.interval_s) + " · " + s.runs + " runs · next in " + rel(s.due_in_s) + "</span>"
      + '<button class="copy-btn" data-sid="' + s.id + '" title="remove">✕</button></div>').join("");
    for (const b of el.querySelectorAll("[data-sid]"))
      b.addEventListener("click", async () => { await fetch("/api/dashboard/schedules/" + b.dataset.sid, { method: "DELETE" }); loadSchedules(); });
  } catch (e) { /* offline */ }
}

/* findings — the developer-facing "what's broken" list */
const SEV_COLOR = { critical: "var(--status-error)", high: "var(--status-error)", medium: "var(--status-warn)", low: "var(--accent-2)", info: "var(--label-secondary)" };
async function loadFindings() {
  try {
    const data = await fetch("/api/dashboard/findings?limit=200").then((r) => r.json());
    const el = $("findings"), counts = $("find-counts");
    const c = data.counts || {};
    counts.innerHTML = ["critical", "high", "medium", "low"].filter((s) => c[s])
      .map((s) => '<span style="color:' + SEV_COLOR[s] + '">' + c[s] + " " + s + "</span>").join(" · ") || "";
    if (!data.findings || !data.findings.length) {
      el.innerHTML = '<span class="d">No findings yet — run API-contract, auth, live-data, vitals or audit and issues will collect here.</span>';
      return;
    }
    el.innerHTML = '<div style="overflow-x:auto"><table class="runs-table"><tbody>'
      + "<tr><th>severity</th><th>source</th><th>what's broken</th><th>detail</th><th>where</th><th>when</th></tr>"
      + data.findings.map((f) => "<tr>"
        + '<td><span class="chip" style="color:' + (SEV_COLOR[f.severity] || "") + '">' + esc(f.severity) + "</span></td>"
        + '<td class="d">' + esc(KIND_LABELS[f.source] || f.source) + "</td>"
        + "<td>" + esc(f.title) + (f.url ? ' <span class="d">· ' + esc(f.url) + "</span>" : "") + "</td>"
        + '<td class="d" style="max-width:340px">' + esc(f.detail || "") + "</td>"
        + '<td class="d"><code>' + esc(f.where || "") + "</code></td>"
        + '<td class="d">' + relIso(f.at) + "</td></tr>").join("")
      + "</tbody></table></div>";
  } catch (e) { /* offline */ }
}
$("find-clear").addEventListener("click", async () => {
  await fetch("/api/dashboard/findings", { method: "DELETE" });
  loadFindings();
});

$("sc-add").addEventListener("click", async () => {
  const kind = $("sc-kind").value, arg = $("sc-arg").value.trim();
  // card-driven kinds pull their params from their own action cards
  const CARD_KINDS = ["flow", "route_sweep", "api_contract", "realtime", "vitals"];
  const params = kind === "audit" ? { url: arg || "https://zyvor.dev", max_pages: 5 }
    : kind === "ping" ? { urls: arg || "https://zyvor.dev" }
    : kind === "tls" ? { host: arg || "zyvor.dev" }
    : CARD_KINDS.includes(kind) ? jobParams(kind)
    : {};
  if (kind === "flow" && !(params.url && params.description)) {
    toast("schedule", false, "fill the 🎬 Flow test card (URL + steps) first"); return;
  }
  if (["route_sweep", "api_contract", "realtime", "vitals"].includes(kind) && !params.url) {
    toast("schedule", false, "fill the matching action card first"); return;
  }
  const res = await fetch("/api/dashboard/schedules", {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ kind, interval_s: parseInt($("sc-interval").value, 10), params }),
  });
  if (res.status === 400) { const d = await res.json(); toast("schedule", false, d.detail || "invalid"); return; }
  toast("schedule", true, "added — running " + (KIND_LABELS[kind] || kind) + " on a loop");
  loadSchedules();
});

