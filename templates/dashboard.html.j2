<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zyvor Mission Control</title>
<style>
  /* Zyvor QA — Mission Control console theme (blue-biased dark) */
  :root {
    color-scheme: dark;
    --radius-liquid: 14px;
    --blur-liquid: 0px;
    --bg: #0a0d12;
    --accent: #3b82f6;
    --accent-2: #a78bfa;
    --surface-base: #131a24;
    --surface-elevated: #1a232f;
    --surface-strong: #1f2937;
    --surface-muted: rgba(148, 168, 200, 0.05);
    --separator: rgba(148, 168, 200, 0.12);
    --fill-secondary: rgba(148, 168, 200, 0.08);
    --glass-border-strong: rgba(148, 168, 200, 0.22);
    --glass-shadow: 0 20px 45px -25px rgba(0, 0, 0, 0.7);
    --glass-highlight: rgba(148, 168, 200, 0.06);
    --text-primary: #e9eef6;
    --text-secondary: #aeb9cb;
    --text-muted: #74829a;
    --status-ok: #22c55e;
    --status-warn: #f5a623;
    --status-error: #ef4444;
    --status-info: #3b82f6;
    --status-neutral: #74829a;
    --font-base: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-mono: ui-monospace, 'SF Mono', SFMono-Regular, 'JetBrains Mono', 'Cascadia Code', Menlo, monospace;
  }
  * { box-sizing: border-box; }
  html, body { min-height: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text-primary);
    font-family: var(--font-base);
    font-size: 14px; line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  body::before {
    content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background:
      radial-gradient(ellipse 60% 50% at 15% -5%, rgba(59,130,246,0.13), transparent 60%),
      radial-gradient(ellipse 50% 40% at 90% 8%, rgba(167,139,250,0.09), transparent 55%);
  }
  main { max-width: 1200px; margin: 0 auto; padding: 24px 28px 60px; position: relative; z-index: 1; }

  .glass {
    background-color: var(--surface-base);
    border: 1px solid var(--separator);
    box-shadow: var(--glass-shadow);
    border-radius: var(--radius-liquid);
  }

  /* hero */
  .hero {
    position: relative; overflow: hidden;
    border: 1px solid var(--separator); border-radius: var(--radius-liquid);
    background:
      linear-gradient(180deg, rgba(34,197,94,0.05), transparent 40%),
      var(--surface-base);
    box-shadow: var(--glass-shadow);
    padding: 22px 24px; margin-bottom: 24px;
  }
  .hero-shine { display: none; }
  .hero-head { position: relative; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .icon-badge {
    display: flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; border-radius: 12px; flex: none;
    background: linear-gradient(150deg, rgba(59,130,246,0.3), rgba(167,139,250,0.15));
    border: 1px solid var(--separator);
  }
  .hero h1 { font-family: var(--font-mono); font-size: 22px; font-weight: 700; letter-spacing: 0.02em; margin: 0; }
  .hero .subtitle { color: var(--text-secondary); font-size: 13px; margin-top: 2px; }
  .hero .sync { margin-left: auto; color: var(--text-muted); font-size: 12px; }
  .status-line { display: inline-flex; align-items: center; gap: 8px; }
  .status-line .lamp { width: 11px; height: 11px; border-radius: 50%; flex: none; }
  .hero[data-status="go"]       .lamp { background: var(--status-ok); box-shadow: 0 0 14px var(--status-ok); }
  .hero[data-status="go"]       h1 span { color: var(--status-ok); }
  .hero[data-status="degraded"] .lamp { background: var(--status-warn); box-shadow: 0 0 14px var(--status-warn); }
  .hero[data-status="degraded"] h1 span { color: var(--status-warn); }
  .hero[data-status="down"]     .lamp { background: var(--status-error); box-shadow: 0 0 14px var(--status-error); animation: pulse 1.1s infinite; }
  .hero[data-status="down"]     h1 span { color: var(--status-error); }
  .hero[data-status="offline"]  .lamp { background: var(--status-neutral); }
  .hero[data-status="offline"]  h1 span { color: var(--text-secondary); }
  @keyframes pulse { 50% { opacity: 0.35; } }

  .stat-grid { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 18px; }
  .stat-tile {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 0.9rem 1.05rem; border-radius: 12px;
    border: 1px solid var(--separator); background: var(--surface-muted);
  }
  .stat-label { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .stat-value { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .stat-sub { font-size: 0.72rem; color: var(--text-muted); }

  h2 { font-family: var(--font-mono); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin: 28px 0 12px; letter-spacing: 0.14em; }

  .strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .card { padding: 16px 18px; }
  .card .k { color: var(--text-muted); font-size: 12px; font-family: var(--font-mono); }
  .card .v { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; margin-top: 2px; font-variant-numeric: tabular-nums; }
  .card .d { color: var(--text-secondary); font-size: 12px; margin-top: 3px; }

  .pods { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .pod { cursor: pointer; transition: background-color .15s, border-color .15s; }
  .pod:hover { background-color: var(--surface-elevated); border-color: var(--glass-border-strong); }
  .pod .row { display: flex; align-items: center; gap: 9px; }
  .pod .dot { width: 10px; height: 10px; border-radius: 50%; flex: none; animation: pulse 2.4s infinite; }
  .pod .name { font-weight: 600; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pod .phase { margin-left: auto; font-size: 11px; color: var(--text-secondary); white-space: nowrap; }
  .pod .meta { display: flex; gap: 12px; flex-wrap: wrap; color: var(--text-muted); font-size: 12px; margin-top: 10px; }
  .pod .meta b { color: var(--text-secondary); font-weight: 600; font-variant-numeric: tabular-nums; }
  .pod .restarts-bad { color: var(--status-error); font-weight: 700; }
  .pod .warn { color: var(--status-warn); font-size: 12px; margin-top: 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .empty {
    color: var(--text-secondary); padding: 18px 20px;
    border: 1px solid var(--separator); border-radius: var(--radius-liquid);
    background: var(--surface-muted);
  }
  .empty code { font-family: var(--font-mono); color: var(--text-primary); background: var(--fill-secondary); padding: 1px 6px; border-radius: 6px; }

  .qa { display: grid; grid-template-columns: 300px 1fr 300px; gap: 14px; }
  @media (max-width: 1100px) { .qa { grid-template-columns: 300px 1fr; } }
  @media (max-width: 800px) { .qa { grid-template-columns: 1fr; } }
  .spark-wrap { position: relative; }
  .spark-tip {
    position: absolute; pointer-events: none; display: none;
    background: var(--surface-strong); border: 1px solid var(--glass-border-strong); border-radius: 10px;
    backdrop-filter: blur(var(--blur-liquid)); -webkit-backdrop-filter: blur(var(--blur-liquid));
    padding: 4px 10px; font-size: 12px; color: var(--text-primary); white-space: nowrap; z-index: 2;
    box-shadow: var(--glass-shadow);
  }
  .runs-table { width: 100%; border-collapse: collapse; }
  .runs-table tr { transition: background 0.12s ease; }
  .runs-table tr:hover { background: var(--fill-secondary); }
  .runs-table td { padding: 7px 10px; border-bottom: 1px solid var(--separator); font-size: 13px; color: var(--text-secondary); }
  .runs-table td:first-child { color: var(--text-muted); font-size: 12px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .chip {
    display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 9999px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.04);
  }
  .chip.pass { color: var(--status-ok); }
  .chip.fail { color: var(--status-error); }

  .drawer {
    position: fixed; top: 0; right: 0; bottom: 0; width: min(680px, 92vw);
    background-color: var(--surface-strong);
    backdrop-filter: blur(var(--blur-liquid)) saturate(1.25);
    -webkit-backdrop-filter: blur(var(--blur-liquid)) saturate(1.25);
    border-left: 1px solid var(--glass-border-strong);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    transform: translateX(100%); transition: transform .18s ease; z-index: 10;
    display: flex; flex-direction: column;
  }
  .drawer.open { transform: translateX(0); }
  .drawer header { padding: 14px 18px; border-bottom: 1px solid var(--separator); display: flex; align-items: center; }
  .drawer header b { font-family: var(--font-mono); font-size: 13px; }
  .drawer header .close {
    margin-left: auto; cursor: pointer; color: var(--text-secondary);
    background: var(--surface-muted); border: 1px solid var(--separator); border-radius: 9999px;
    width: 28px; height: 28px; font-size: 14px; line-height: 1;
  }
  .drawer header .close:hover { color: var(--text-primary); background: var(--fill-secondary); }
  .drawer pre {
    flex: 1; overflow: auto; margin: 0; padding: 14px 18px;
    font-family: var(--font-mono); font-size: 12px; line-height: 1.6; color: var(--text-secondary);
    white-space: pre-wrap; word-break: break-all;
  }
  .run-btn {
    cursor: pointer; padding: 3px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600;
    color: var(--text-primary); background: var(--surface-muted);
    border: 1px solid var(--separator); font-family: var(--font-base);
    transition: background .15s, border-color .15s;
  }
  .run-btn:hover:not(:disabled) { background: rgba(0, 122, 255, 0.18); border-color: var(--accent); }
  .run-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .run-status { font-size: 12px; font-weight: 400; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 6px; }
  .run-status .spin {
    width: 9px; height: 9px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 8px var(--accent); animation: pulse 1.2s infinite;
  }
  .run-status.err { color: var(--status-error); }
  .livecase { display: inline-flex; align-items: center; gap: 5px; margin: 2px 6px 2px 0; font-size: 12px; }
  .livecase .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .livecase.pass .dot { background: var(--status-ok); }
  .livecase.fail .dot { background: var(--status-error); }
  .livecase.fail { color: var(--status-error); }
  .err-summary { border: 1px solid rgba(255,69,58,0.35); background: rgba(255,69,58,0.06); border-radius: 12px; padding: 12px 14px; margin: 10px 0; }
  .err-summary .k { color: var(--status-error); font-weight: 600; font-size: 12px; margin-bottom: 6px; }
  .case-err { color: #fca5a5; font-family: var(--font-mono); font-size: 11px; white-space: pre-wrap; max-width: 640px; }
  .copy-btn { cursor: pointer; font-size: 11px; color: var(--text-muted); background: none; border: none; padding: 0 4px; }
  .copy-btn:hover { color: var(--text-primary); }
  .dl-row { display: flex; gap: 8px; align-items: center; margin-top: 10px; flex-wrap: wrap; }
  .dl-row a, .dl-row button { text-decoration: none; }
  .acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .brand-eyebrow {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; font-weight: 600;
    background: linear-gradient(110deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .act-title { font-weight: 700; font-size: 13px; margin-bottom: 10px; letter-spacing: -0.01em; }
  .act:hover { border-color: rgba(59,130,246,0.4); }
  .act { transition: border-color .18s; }
  .act-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .act-row:last-child { margin-bottom: 0; }
  .inp {
    background: rgba(255, 255, 255, 0.08); border: 1px solid var(--separator); color: var(--text-primary);
    border-radius: 0.625rem; padding: 5px 10px; font-size: 12px; font-family: var(--font-base);
  }
  .inp:focus { outline: none; border-color: rgba(0, 122, 255, 0.5); box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.18); }
  .inp.grow { flex: 1; min-width: 120px; }
  textarea.inp { resize: vertical; }
  .chk { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-secondary); }
  .chk input { accent-color: var(--accent); }
  .result-title { font-weight: 600; font-size: 13px; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
  .result-files { font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); line-height: 1.7; }
  .result-err { color: var(--status-error); font-size: 13px; }
  .rlink { color: var(--accent); text-decoration: none; font-size: 12px; }
  .rlink:hover { text-decoration: underline; }
  /* toasts */
  #toasts { position: fixed; top: 18px; right: 18px; z-index: 50; display: flex; flex-direction: column; gap: 10px; }
  .toast {
    background-color: var(--surface-strong); border: 1px solid var(--glass-border-strong);
    backdrop-filter: blur(var(--blur-liquid)); -webkit-backdrop-filter: blur(var(--blur-liquid));
    border-radius: 14px; padding: 10px 16px; box-shadow: var(--glass-shadow);
    font-size: 13px; display: flex; align-items: center; gap: 10px; min-width: 240px;
    animation: toast-in .25s ease-out;
  }
  @keyframes toast-in { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
  .toast.ok { border-left: 3px solid var(--status-ok); }
  .toast.bad { border-left: 3px solid var(--status-error); }
  .toast .t-kind { font-weight: 600; }
  .toast .t-sub { color: var(--text-secondary); font-size: 12px; }

  /* activity feed */
  .feed { display: flex; flex-direction: column; gap: 0; max-height: 300px; overflow-y: auto; }
  .feed-item { display: flex; align-items: baseline; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--separator); font-size: 12px; }
  .feed-item:last-child { border-bottom: none; }
  .feed-item .f-when { color: var(--text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .feed-item .f-kind { font-weight: 600; white-space: nowrap; }
  .feed-item .f-brief { color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* pod search */
  .pod-search { margin-left: 10px; width: 190px; font-weight: 400; }

  /* stat trend */
  .trend-up { color: var(--status-ok); }
  .trend-down { color: var(--status-error); }

  /* log drawer controls */
  .drawer-controls { display: flex; align-items: center; gap: 8px; padding: 8px 18px; border-bottom: 1px solid var(--separator); flex-wrap: wrap; }
  .drawer-controls .inp { padding: 3px 8px; font-size: 11px; }
  .drawer-controls .chk { font-size: 11px; }
  .dl-btn {
    cursor: pointer; font-size: 11px; padding: 3px 10px; border-radius: 9999px;
    color: var(--text-secondary); background: var(--surface-muted); border: 1px solid var(--separator);
  }
  .dl-btn:hover { color: var(--text-primary); background: var(--fill-secondary); }

  /* expandable run rows */
  .runs-table tr.expandable { cursor: pointer; }
  .run-detail td {
    background: var(--surface-muted); font-size: 12px; color: var(--text-secondary);
    white-space: pre-wrap; padding: 10px 12px;
  }

  /* command palette */
  #palette { position: fixed; inset: 0; z-index: 55; background: rgba(0,0,0,0.5); display: flex; align-items: flex-start; justify-content: center; padding-top: 12vh; }
  .palette-box { width: min(560px, 92vw); border-radius: 16px; padding: 10px; }
  #palette-input { width: 100%; font-size: 15px; padding: 10px 12px; margin-bottom: 6px; }
  .palette-item { padding: 9px 12px; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .palette-item.sel { background: rgba(0,122,255,0.18); }
  .palette-item .pk { color: var(--text-muted); margin-left: auto; font-size: 11px; }

  footer { margin-top: 36px; color: var(--text-muted); font-size: 12px; display: flex; gap: 18px; }
  kbd {
    border: 1px solid var(--separator); border-radius: 6px; padding: 0 6px; font-size: 11px;
    font-family: var(--font-mono); background: var(--surface-muted);
  }
</style>
</head>
<body>
<main>
  <div class="hero" data-status="offline" id="hero">
    <div class="hero-shine" aria-hidden="true"></div>
    <div class="hero-head">
      <div class="icon-badge" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <div>
        <div class="brand-eyebrow">ZYVOR QA · MISSION CONTROL</div>
        <h1><span id="banner-title">STANDBY</span></h1>
        <div class="subtitle status-line"><span class="lamp"></span><span id="banner-sub">waiting for first sync</span></div>
      </div>
      <span class="sync" style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <span id="sync">connecting…</span>
        <span id="session" style="display:none">🔐 <b id="session-user"></b> · <a class="rlink" href="#" id="logout">sign out</a></span>
      </span>
    </div>
    <div class="stat-grid">
      <div class="stat-tile"><span class="stat-label">Pods</span><span class="stat-value" id="stat-pods">—</span><span class="stat-sub" id="stat-pods-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Replicas</span><span class="stat-value" id="stat-replicas">—</span><span class="stat-sub" id="stat-replicas-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Last QA run</span><span class="stat-value" id="stat-run">—</span><span class="stat-sub" id="stat-run-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Pass rate</span><span class="stat-value" id="stat-rate">—</span><span class="stat-sub" id="stat-rate-sub">last 30 runs</span></div>
      <div class="stat-tile"><span class="stat-label">Next smoke run</span><span class="stat-value" id="stat-cron">—</span><span class="stat-sub" id="stat-cron-sub"></span></div>
    </div>
  </div>

  <h2>Workloads</h2>
  <div class="strip" id="workloads"><div class="empty">No workload data yet.</div></div>

  <h2 style="display:flex;align-items:center">Pods <span style="color:var(--text-muted);font-weight:400;margin-left:6px" id="ns"></span>
    <input class="inp pod-search" id="pod-search" placeholder="filter pods…">
    <button class="dl-btn" id="events-toggle" style="margin-left:8px">⚡ events</button>
  </h2>
  <div class="glass card" id="events-panel" style="display:none;margin-bottom:14px">
    <div class="k" style="margin-bottom:8px">Recent cluster events</div>
    <div style="overflow-x:auto"><table class="runs-table" id="events-table"><tbody></tbody></table></div>
  </div>
  <div class="pods" id="pods"><div class="empty">No pod data yet.</div></div>

  <h2 style="display:flex;align-items:center;gap:12px">Actions <span id="run-status" class="run-status"></span></h2>

  <div class="glass card" id="job-live" style="display:none;margin-bottom:14px">
    <div class="result-title" style="margin-bottom:10px">
      <span class="spin" style="width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent);animation:pulse 1.2s infinite"></span>
      <span id="live-kind">job</span> running
      <span class="d" id="live-elapsed" style="font-weight:400"></span>
      <span id="live-tally" style="font-weight:400"></span>
      <button class="dl-btn" id="btn-copylog" style="margin-left:auto">⧉ copy log</button>
      <button class="dl-btn" id="btn-dllog">⬇ .txt</button>
      <button class="run-btn" id="btn-stop" style="color:var(--status-error);border-color:rgba(255,69,58,0.4)">⏹ Stop</button>
    </div>
    <div id="live-cases" style="margin-bottom:10px"></div>
    <pre id="live-log" style="margin:0;max-height:200px;overflow-y:auto;font-family:var(--font-mono);font-size:12px;line-height:1.7;color:var(--text-secondary);white-space:pre-wrap"></pre>
  </div>
  <div class="acts">
    <div class="glass card act">
      <div class="act-title">▶ Run tests</div>
      <div class="act-row">
        <select class="inp" id="run-source"><option value="local">local</option><option value="github">github</option></select>
        <input class="inp grow" id="run-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row">
        <input class="inp" id="run-pr" type="number" placeholder="PR #" style="width:80px">
        <label class="chk"><input type="checkbox" id="run-coverage"> expand coverage</label>
      </div>
      <div class="act-row">
        <button class="run-btn act-btn" data-kind="smoke">▶ Smoke</button>
        <button class="run-btn act-btn" data-kind="full">▶ Full pipeline</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">⚙ Generate tests</div>
      <div class="act-row">
        <select class="inp" id="gen-source"><option value="local">local</option><option value="github">github</option></select>
        <input class="inp grow" id="gen-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row"><label class="chk"><input type="checkbox" id="gen-coverage"> expand coverage</label></div>
