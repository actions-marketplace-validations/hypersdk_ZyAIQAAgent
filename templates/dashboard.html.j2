/* job triggers — every CLI capability, online */
function jobParams(kind) {
  if (kind === "smoke") return {};
  if (kind === "full") return {
    source: $("run-source").value,
    spec: $("run-spec").value.trim(),
    pr_number: $("run-pr").value ? parseInt($("run-pr").value, 10) : null,
    expand_coverage: $("run-coverage").checked,
  };
  if (kind === "generate") return {
    source: $("gen-source").value,
    spec: $("gen-spec").value.trim(),
    expand_coverage: $("gen-coverage").checked,
  };
  if (kind === "discover") return { source: $("disc-source").value };
  if (kind === "create") return { description: $("nl-desc").value.trim(), execute: $("nl-execute").checked };
  if (kind === "regression") return { update_baselines: $("reg-update").checked };
  if (kind === "crawl_test") return {
    url: $("ct-url").value.trim(),
    username: $("ct-user").value.trim(),
    password: $("ct-pass").value,
    insecure: $("ct-insecure").checked,
    max_pages: parseInt($("ct-pages").value, 10) || 30,
  };
  if (kind === "audit") return {
    url: $("au-url").value.trim(),
    max_pages: parseInt($("au-pages").value, 10) || 10,
    insecure: $("au-insecure").checked,
    checks: Array.from(document.querySelectorAll("#au-checks input:checked")).map((c) => c.value),
  };
  if (kind === "flaky") return { runs: parseInt($("fl-runs").value, 10) || 3, target: "manual" };
  if (kind === "screenshot") return {
    url: $("sh-url").value.trim(),
    viewports: Array.from(document.querySelectorAll("#sh-vps input:checked")).map((c) => c.value).filter((v) => v !== "on"),
    full_page: $("sh-full").checked,
  };
  if (kind === "compare") return { url_a: $("cmp-a").value.trim(), url_b: $("cmp-b").value.trim(), insecure: $("cmp-insecure").checked };
  if (kind === "ping") return { urls: $("pg-urls").value };
  if (kind === "loadtest") return { url: $("lt-url").value.trim(), requests: parseInt($("lt-n").value, 10) || 100, concurrency: parseInt($("lt-c").value, 10) || 10 };
  if (kind === "tls") return { host: $("tls-host").value.trim() };
  if (kind === "flow") return {
    url: $("fw-url").value.trim(),
    description: $("fw-desc").value,
    username: $("fw-user").value.trim(),
    password: $("fw-pass").value,
    session: $("fw-session").value.trim(),
    browser: $("fw-browser").value,
    device: $("fw-device").value,
    throttle: $("fw-throttle").value,
    insecure: $("fw-insecure").checked,
    record: $("fw-record").checked,
  };
  if (kind === "ai_flow") return {
    url: $("ai-url").value.trim(),
    goal: $("ai-goal").value.trim(),
    session: $("ai-session").value.trim(),
    max_steps: parseInt($("ai-steps").value, 10) || 20,
    insecure: $("ai-insecure").checked,
  };
  if (kind === "route_sweep") return {
    url: $("rs-url").value.trim(),
    routes: $("rs-routes").value,
    viewports: Array.from(document.querySelectorAll("#rs-vps input[value]:checked")).map((c) => c.value),
    update_baselines: $("rs-update").checked,
    insecure: $("rs-insecure").checked,
    auto: $("rs-auto").checked,
  };
  if (kind === "api_contract") {
    let spec = $("api-spec").value.trim();
    const inline = $("api-spec-json").value.trim();
    if (inline) { try { spec = JSON.parse(inline); } catch (e) { toast("api", false, "inline spec is not valid JSON"); throw e; } }
    const tok = $("api-token").value.trim();
    return {
      url: $("api-url").value.trim(),
      mode: "spec",
      spec,
      auth: tok ? { token: tok } : null,
      include_writes: $("api-writes").checked,
      insecure: $("api-insecure").checked,
    };
  }
  if (kind === "vitals") return {
    url: $("cwv-url").value.trim(),
    device: $("cwv-device").value,
    throttle: $("cwv-throttle").value,
    insecure: $("cwv-insecure").checked,
  };
  if (kind === "realtime") return {
    url: $("rt-url").value.trim(),
    ws: $("rt-ws").value.trim(),
    sse: $("rt-sse").value.trim(),
    ticket_url: $("rt-ticket").value.trim(),
    token: $("rt-token").value.trim(),
    subprotocol_jwt: $("rt-subproto").checked,
    expect_messages: parseInt($("rt-expect").value, 10) || 1,
    live_selector: $("rt-live").value.trim(),
    insecure: $("rt-insecure").checked,
  };
  if (kind === "auth_test") return {
    url: $("au-url").value.trim(),
    protected: $("au-protected").value.trim() || "/",
    login_url: $("au-login").value.trim(),
    api_login: $("au-api").value.trim(),
    logout_url: $("au-logout").value.trim(),
    username: $("au-user").value.trim(),
    password: $("au-pass").value,
    save_session: $("au-save").checked,
    insecure: $("au-insecure").checked,
  };
  const PROBES = ["redirects","headers","cookies","robots","security_paths","api_check","sitemap_test","dns_records","cors","transport"];
  if (PROBES.includes(kind)) {
    const t = $("pr-target").value.trim();
    return kind === "dns_records" ? { host: t } : { url: t };
  }
  return {};
}

async function startJob(kind) {
  const el = $("run-status");
  el.classList.remove("err");
  if (kind === "regression" && $("reg-update").checked
      && !confirm("Update baselines? Current screenshots become the new reference.")) return;
  try {
    const res = await fetch("/api/dashboard/jobs", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ kind, params: jobParams(kind) }),
    });
    if (res.status === 409) { el.textContent = "a job is already in progress"; return; }
    if (res.status === 400 || res.status === 422) {
      const data = await res.json();
      el.classList.add("err");
      el.textContent = String(data.detail || "invalid request").slice(0, 90);
      return;
    }
    $("job-result").style.display = "none";
    await sync();
    $("job-live").scrollIntoView({ behavior: "smooth", block: "center" });
  } catch (err) {
    el.classList.add("err");
    el.textContent = "trigger failed: " + err;
  }
}
