const KIND_LABELS = { smoke: "smoke tests", full: "full pipeline", generate: "generate", discover: "discover", create: "NL create", regression: "regression", crawl_test: "crawl & test", audit: "site audit", flaky: "flaky check", screenshot: "screenshot", compare: "compare", ping: "uptime ping", loadtest: "load test", tls: "TLS check",
  redirects: "redirect chain", headers: "HTTP headers", cookies: "cookie audit", robots: "robots/sitemap",
  security_paths: "exposed paths", api_check: "API check", sitemap_test: "sitemap URLs", dns_records: "DNS records",
  cors: "CORS check", transport: "compression", flow: "flow test", route_sweep: "route sweep",
  api_contract: "API contract", auth_test: "auth & session", realtime: "live data", vitals: "web vitals", ai_flow: "AI test" };

let lastToastKey = "";
function renderRunStatus(st) {
  const el = $("run-status");
  const busy = !!(st && st.running);
  for (const btn of document.querySelectorAll(".act-btn")) btn.disabled = busy;

  // live job panel: kind, elapsed, live pass/fail tally, per-test rows, streaming log
  const live = $("job-live");
  if (busy) {
    const secs = st.started_at ? Math.max(0, (Date.now() - new Date(st.started_at).getTime()) / 1000 | 0) : 0;
    live.style.display = "block";
    $("live-kind").textContent = KIND_LABELS[st.kind] || st.kind;
    $("live-elapsed").textContent = "· " + rel(secs) + " elapsed";
    const t = st.live_tally || { passed: 0, failed: 0 };
    $("live-tally").innerHTML = (t.passed || t.failed)
      ? '· <span class="pass">' + t.passed + " ✓</span> "
        + (t.failed ? '<span class="fail">' + t.failed + " ✗</span>" : "")
      : "";
    const lc = st.live_cases || [];
    $("live-cases").innerHTML = lc.slice(-40).map((c) =>
      '<span class="livecase ' + (c.status === "passed" ? "pass" : "fail") + '"><span class="dot"></span>'
      + esc((c.status === "passed" ? "" : "✗ ") + c.title) + "</span>").join("");
    const log = $("live-log");
    const atBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 40;
    log.textContent = (st.progress || []).join("\n") || "starting…";
    if (atBottom) log.scrollTop = log.scrollHeight;
    window._lastLog = (st.progress || []).join("\n");
  } else {
    live.style.display = "none";
  }

  if (busy) {
    el.classList.remove("err");
    el.textContent = "";
  } else if (st && st.error) {
    el.classList.add("err");
    el.textContent = (KIND_LABELS[st.kind] || "job") + " failed: " + st.error.slice(0, 90);
  } else {
    el.classList.remove("err");
    el.textContent = "";
  }

  // toast once per completed job (skip page-load backfill)
  if (st && !st.running && st.finished_at) {
    const key = st.finished_at + (st.kind || "");
    if (lastToastKey && key !== lastToastKey) {
      const r = st.result || {};
      toast(KIND_LABELS[st.kind] || st.kind, !st.error,
        st.error ? st.error.slice(0, 80)
        : (r.total != null ? r.passed + "/" + r.total + " passed" : "completed"));
      // celebrate a clean, non-empty test result
      const clean = !st.error && r.total > 0 && r.failed === 0;
      if (clean && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) confettiBurst();
      beep(clean && !st.error);
    }
    lastToastKey = key;
  } else if (st && !st.finished_at && !lastToastKey) {
    lastToastKey = "init";
  }

  renderFeed(st && st.recent);
  renderJobResult(st);
  ensureBusyPoll(busy);
}

function renderFeed(items) {
  if (!items) return;
  const el = $("feed");
  if (!items.length) {
    el.innerHTML = '<span class="d">No activity yet this session.</span>';
    return;
  }
  el.innerHTML = items.map((it) => {
    if (it.type === "webhook") {
      return '<div class="feed-item"><span class="f-when">' + relIso(it.at) + '</span>'
        + '<span class="f-kind">🪝 ' + esc(it.event) + '</span>'
        + '<span class="f-brief">' + esc((it.repo || "") + (it.detail ? " · " + it.detail : "")) + "</span></div>";
    }
    return '<div class="feed-item"><span class="f-when">' + relIso(it.at) + '</span>'
      + '<span class="f-kind">' + (it.ok ? "✅" : "❌") + " " + esc(KIND_LABELS[it.kind] || it.kind) + '</span>'
      + '<span class="f-brief">' + esc(it.brief) + " · " + rel(it.duration_s | 0) + "</span></div>";
  }).join("");
}

let lastResultKey = "";
function renderJobResult(st) {
  const panel = $("job-result");
  if (!st || st.running || (!st.result && !st.error)) return;
  const key = (st.finished_at || "") + (st.kind || "");
  if (key === lastResultKey && panel.style.display !== "none") return;
  lastResultKey = key;
  const r = st.result || {};
  let dur = "";
  if (st.started_at && st.finished_at) {
    dur = ' <span class="d" style="font-weight:400">· took ' + rel(Math.max(0, (new Date(st.finished_at) - new Date(st.started_at)) / 1000 | 0)) + "</span>";
  }
  let html = '<div class="result-title">' + esc(KIND_LABELS[st.kind] || st.kind) + " result" + dur + "</div>";

  const caseTable = (cases) => {
    if (!cases || !cases.length) return "";
    const fails = cases.filter((c) => c.status !== "passed");
    let out = "";
    if (fails.length) {
      out += '<div class="err-summary"><div class="k">⚠ ' + fails.length + " failure(s)</div>"
        + fails.map((c) => '<div style="margin-bottom:8px"><b>' + esc(c.title) + "</b> "
          + '<button class="copy-btn" data-copy="' + encodeURIComponent(c.error || "") + '">⧉ copy</button>'
          + (c.hint ? '<div style="color:var(--accent-2);font-size:12px;margin:2px 0">💡 ' + esc(c.hint) + "</div>" : "")
          + '<div class="case-err">' + esc((c.error || "").slice(0, 600))
          + (c.console_logs && c.console_logs.length ? "\nconsole: " + esc(c.console_logs.join("\n")) : "")
          + (c.network_errors && c.network_errors.length ? "\nnetwork: " + esc(c.network_errors.join("\n")) : "")
          + "</div></div>").join("") + "</div>";
    }
    out += '<div style="margin:6px 0"><label class="chk"><input type="checkbox" id="fails-only"> failures only</label></div>';
    out += '<table class="runs-table" id="case-table"><tbody>'
      + cases.map((c) => '<tr class="case-row ' + (c.status === "passed" ? "" : "is-fail") + '">'
        + '<td><span class="chip ' + (c.status === "passed" ? "pass" : "fail") + '">'
        + (c.status === "passed" ? "PASS" : esc((c.status || "fail").toUpperCase())) + "</span></td>"
        + "<td>" + esc(c.title) + (c.browser ? ' <span class="d">' + esc(c.browser) + "</span>" : "") + "</td>"
        + '<td class="d">' + (c.duration_ms != null ? c.duration_ms + "ms" : "") + "</td>"
        + "<td>" + (c.video ? '<a class="rlink" href="' + esc(c.video) + '" target="_blank">🎬</a> ' : "")
        + (c.trace ? '<a class="rlink" href="' + esc(c.trace) + '" target="_blank">🔍</a>' : "") + "</td>"
        + '<td style="max-width:420px;color:var(--status-error);font-size:12px">' + esc((c.error || "").slice(0, 200)) + "</td></tr>").join("")
      + "</tbody></table>";
    return out;
  };

  const downloadRow = (rep) => {
    if (!rep || (!rep.csv && !rep.html && !rep.pdf)) return "";
    return '<div class="dl-row">Download: '
      + (rep.csv ? '<a class="dl-btn" href="/api/dashboard/jobs/report.csv">⬇ CSV</a>' : "")
      + (rep.html ? '<a class="dl-btn" href="' + esc(rep.html) + '" target="_blank">⬇ HTML</a>' : "")
      + (rep.pdf ? '<a class="dl-btn" href="/api/dashboard/jobs/report.pdf">⬇ PDF</a>' : "")
      + '<button class="dl-btn" id="btn-rerun">⟳ Rerun</button></div>';
  };

  // generic probe result: {summary, status, columns, rows, issues}
  if (!st.error && r.columns && r.rows) {
    const sc = r.status === "ok" ? "pass" : r.status === "warn" ? "" : "fail";
    html += '<div class="d"><span class="chip ' + sc + '" style="' + (r.status === "warn" ? "color:var(--status-warn)" : "") + '">'
      + esc((r.status || "").toUpperCase()) + "</span> " + esc(r.summary || "") + "</div>";
    if (r.issues && r.issues.length) {
      html += '<div class="err-summary" style="margin:8px 0">' + r.issues.map((i) => '<div class="case-err">' + esc(i) + "</div>").join("") + "</div>";
    }
    html += '<div style="overflow-x:auto"><table class="runs-table" style="margin-top:6px"><tbody>'
      + "<tr>" + r.columns.map((c) => "<th style=\"text-align:left;color:var(--text-muted);font-size:11px\">" + esc(c) + "</th>").join("") + "</tr>"
      + r.rows.map((row) => "<tr>" + row.map((cell, ci) => "<td" + (ci === 0 ? ' class="d"' : "") + ">" + esc(String(cell)) + "</td>").join("") + "</tr>").join("")
      + "</tbody></table></div>";
    panel.innerHTML = html;
    panel.style.display = "block";
    return;
  }

  if (st.error) {
    html += '<div class="result-err">' + esc(st.error) + "</div>";
    if (st.progress && st.progress.length) {
      html += '<pre style="margin:10px 0 0;font-family:var(--font-mono);font-size:11px;color:var(--text-muted);white-space:pre-wrap">'
        + esc(st.progress.slice(-8).join("\n")) + "</pre>";
    }
  } else if (st.kind === "discover") {
    html += '<div class="d">' + r.inventory + " candidates · " + r.gaps_total + " gaps · " + r.files_scanned + " files scanned</div>";
    if (r.gaps && r.gaps.length) {
      html += '<table class="runs-table" style="margin-top:8px"><tbody>'
        + r.gaps.map((g) => "<tr><td>" + esc(g.kind) + "</td><td>" + esc(g.path) + "</td><td>" + esc(g.title) + "</td><td>" + esc(g.priority) + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else if (st.kind === "generate" || st.kind === "create") {
    const files = r.generated || [];
    html += '<div class="d">' + files.length + " test file(s) generated"
      + (r.requirements != null ? " from " + r.requirements + " requirement(s)" : "")
      + (r.total != null ? " · executed: " + r.passed + "/" + r.total + " passed" : "") + "</div>";
    html += '<div class="result-files" style="margin-top:6px">' + files.map(esc).join("<br>") + "</div>";
  } else if (st.kind === "ai_flow") {
    html += '<div class="d"><b class="' + (r.success ? "pass" : "fail") + '">' + (r.success ? "✅ goal achieved" : "⚠ stopped") + "</b> · "
      + esc(r.goal) + ' <span class="d">· ' + esc(r.mode || "") + " agent</span></div>";
    if (r.summary) html += '<div class="d" style="margin:4px 0">' + esc(r.summary) + "</div>";
    if (r.video) html += '<video controls src="' + esc(r.video) + '" style="max-width:520px;width:100%;border:1px solid var(--separator);border-radius:10px;margin:10px 0"></video>';
    if (r.trace) html += '<div class="dl-row" style="margin:2px 0 8px">🔍 <a class="rlink" href="' + esc(r.trace) + '" target="_blank">download trace.zip</a></div>';
    html += '<table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.ai_steps || []).map((s) => "<tr><td>" + s.n + "</td>"
        + '<td><span class="chip ' + (s.status === "passed" ? "pass" : "fail") + '">' + (s.status === "passed" ? "OK" : "FAIL") + "</span></td>"
        + "<td>" + esc(s.desc || s.action) + "</td>"
        + "<td>" + (s.shot ? '<a class="rlink" href="' + esc(s.shot) + '" target="_blank">shot</a>' : "")
        + '</td><td class="d" style="color:var(--status-error);max-width:300px">' + esc(s.error || "") + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "flow") {
    html += '<div class="d"><b class="' + (r.failed ? "fail" : "pass") + '">' + r.passed + "/" + r.total + " steps passed</b> · "
      + esc(r.url) + " · parsed by " + esc(r.mode)
      + (r.browser && r.browser !== "chromium" ? " · " + esc(r.browser) : "")
      + (r.device && r.device !== "desktop" ? " · " + esc(r.device) : "")
      + (r.throttle && r.throttle !== "none" ? " · " + esc(r.throttle) : "") + "</div>";
    if (r.video) html += '<video controls src="' + esc(r.video) + '" style="max-width:520px;width:100%;border:1px solid var(--separator);border-radius:10px;margin:10px 0"></video>';
    if (r.trace) html += '<div class="dl-row" style="margin:2px 0 8px">🔍 <a class="rlink" href="' + esc(r.trace) + '" target="_blank">download trace.zip</a> <span class="d">— open at trace.playwright.dev for step-by-step DOM/network/console</span></div>';
    html += '<table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.flow_steps || []).map((s) => "<tr><td>" + s.n + "</td>"
        + '<td><span class="chip ' + (s.status === "passed" ? "pass" : "fail") + '">' + (s.status === "passed" ? "PASS" : "FAIL") + "</span></td>"
        + "<td>" + esc(s.desc) + "</td>"
        + "<td>" + (s.shot ? '<a class="rlink" href="' + esc(s.shot) + '" target="_blank">shot</a>' : "") + "</td>"
        + '<td style="color:var(--status-error);font-size:12px;max-width:360px">' + esc(s.error || "")
        + (s.hint ? '<div style="color:var(--accent-2)">💡 ' + esc(s.hint) + "</div>" : "") + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "route_sweep") {
    html += '<div class="d">' + r.routes + " route(s) × " + (r.viewports || []).join("/") + " · "
      + (r.baselines_updated ? '<span class="pass">' + r.new_baselines + " baseline(s) captured</span>"
         : '<span class="' + (r.fail_count ? "fail" : "pass") + '">' + r.fail_count + " changed</span>") + "</div>";
    html += '<div style="overflow-x:auto"><table class="runs-table" style="margin-top:6px"><tbody>'
      + "<tr><th>route</th><th>viewport</th><th>status</th><th>diff</th><th></th></tr>"
      + (r.sweep_rows || []).map((x) => "<tr><td>" + esc(x.route) + "</td><td class=\"d\">" + esc(x.viewport) + "</td>"
        + '<td style="color:' + (x.status === "fail" ? "var(--status-error)" : x.status === "baseline" ? "var(--status-warn)" : "var(--status-ok)") + '">' + esc(x.status) + "</td>"
        + "<td>" + (x.diff || 0) + "%</td>"
        + '<td><a class="rlink" href="' + esc(x.cur) + '" target="_blank">view</a></td></tr>').join("")
      + "</tbody></table></div>";
  } else if (st.kind === "api_contract") {
    html += '<div class="d"><b class="' + (r.failed ? "fail" : "pass") + '">' + r.passed + "/" + r.total
      + " checks passed</b> · " + esc(r.url) + " · " + esc(r.mode) + " mode</div>";
    const rows = r.mode === "spec" ? (r.endpoints || []) : (r.steps || []);
    html += '<div style="overflow-x:auto"><table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.mode === "spec" ? "<tr><th>method</th><th>path</th><th>status</th><th>result</th><th>schema / note</th><th>ms</th></tr>"
                           : "<tr><th>#</th><th>step</th><th>status</th><th>result</th><th>error</th><th>ms</th></tr>")
      + rows.map((x) => "<tr>"
        + (r.mode === "spec"
            ? "<td><b>" + esc(x.method) + "</b></td><td><code>" + esc(x.path) + "</code></td><td>" + x.status + "</td>"
              + '<td><span class="chip ' + (x.ok ? "pass" : "fail") + '">' + (x.ok ? "OK" : "FAIL") + "</span></td>"
              + '<td style="color:var(--status-error);font-size:12px;max-width:360px">' + esc((x.schema_errors || []).join("; ") || x.note || "") + "</td>"
            : "<td>" + x.n + "</td><td>" + esc(x.desc) + "</td><td>" + x.status + "</td>"
              + '<td><span class="chip ' + (x.ok ? "pass" : "fail") + '">' + (x.ok ? "OK" : "FAIL") + "</span></td>"
              + '<td style="color:var(--status-error);font-size:12px;max-width:360px">' + esc(x.error || "") + "</td>")
        + "<td>" + (x.latency_ms || 0) + "</td></tr>").join("")
      + "</tbody></table></div>";
  } else if (st.kind === "vitals") {
    const gc = (g) => g === "good" ? "var(--status-ok)" : g === "poor" ? "var(--status-error)" : "var(--status-warn)";
    html += '<div class="d">overall <b style="color:' + gc(r.overall) + '">' + esc((r.overall || "").toUpperCase()) + "</b> · "
      + esc(r.url) + " · " + esc(r.device || "desktop") + (r.throttle && r.throttle !== "none" ? " · " + esc(r.throttle) : "") + "</div>";
    html += '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">'
      + Object.entries(r.metrics || {}).map(([k, m]) =>
          '<div class="stat-tile" style="padding:8px 12px"><span class="stat-label">' + k + '</span>'
          + '<span class="stat-value" style="font-size:1rem;color:' + gc(m.grade) + '">'
          + (m.value == null ? "—" : m.value + (k === "CLS" ? "" : "ms")) + "</span></div>").join("") + "</div>";
    if (r.shot_url) html += '<img src="' + esc(r.shot_url) + '" style="max-width:420px;width:100%;border:1px solid var(--separator);border-radius:10px;margin-top:10px">';
  } else if (st.kind === "realtime") {
    html += '<div class="d"><b class="' + (r.failed ? "fail" : "pass") + '">' + r.passed + "/" + r.total + " checks passed</b> · " + esc(r.url)
      + (r.live ? " · page <b style=\"color:" + (r.live.classification === "ok" ? "var(--status-ok)" : "var(--status-error)") + '">' + esc(r.live.classification) + "</b>" : "") + "</div>";
    html += '<table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.checks || []).map((c) => "<tr>"
        + '<td><span class="chip ' + (c.ok ? "pass" : "fail") + '">' + (c.ok ? "OK" : "FAIL") + "</span></td>"
        + "<td>" + esc(c.name) + '</td><td class="d">' + esc(c.detail || "") + "</td></tr>").join("")
      + "</tbody></table>";
    if (r.shot_url) html += '<img src="' + esc(r.shot_url) + '" style="max-width:420px;width:100%;border:1px solid var(--separator);border-radius:10px;margin-top:10px">';
  } else if (st.kind === "auth_test") {
    html += '<div class="d"><b class="' + (r.failed ? "fail" : "pass") + '">' + r.passed + "/" + r.total + " checks passed</b> · " + esc(r.url)
      + (r.session_name ? ' · session <code>' + esc(r.session_name) + "</code> (reuse via <b>session</b> on flow/live-data)" : "") + "</div>";
    html += '<table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.checks || []).map((c) => "<tr>"
        + '<td><span class="chip ' + (c.ok ? "pass" : "fail") + '">' + (c.ok ? "OK" : "FAIL") + "</span></td>"
        + "<td>" + esc(c.name) + '</td><td class="d">' + esc(c.detail || "") + "</td></tr>").join("")
      + "</tbody></table>";
    if (r.shot_url) html += '<img src="' + esc(r.shot_url) + '" style="max-width:420px;width:100%;border:1px solid var(--separator);border-radius:10px;margin-top:10px">';
  } else if (st.kind === "loadtest") {
    html += '<div class="d">' + esc(r.url) + " — " + r.requests + " requests · " + r.concurrency + " concurrent · "
      + '<b>' + r.rps + " req/s</b> · <span class=\"" + (r.success_pct >= 99 ? "pass" : "fail") + '">' + r.success_pct + "% ok</span></div>";
    const cell = (k, v) => '<div class="stat-tile" style="padding:8px 12px"><span class="stat-label">' + k + '</span><span class="stat-value" style="font-size:1rem">' + v + "ms</span></div>";
    html += '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">'
      + cell("p50", r.p50) + cell("p95", r.p95) + cell("p99", r.p99) + cell("max", r.max) + cell("mean", r.mean) + "</div>";
  } else if (st.kind === "tls") {
    const sc = r.status === "ok" ? "pass" : "fail";
    html += '<div class="d"><span class="chip ' + sc + '">' + esc(r.status.toUpperCase()) + "</span> "
      + esc(r.host) + ":" + r.port + " → " + esc((r.ips || []).join(", ")) + "</div>";
    const row = (k, v) => "<tr><td class=\"d\" style=\"width:130px\">" + k + "</td><td>" + esc(String(v)) + "</td></tr>";
    html += '<table class="runs-table" style="margin-top:8px"><tbody>'
      + row("expires in", (r.days_left != null ? r.days_left + " days" : "?") + " (" + esc(r.expiry || "") + ")")
      + row("issuer", r.issuer) + row("subject", r.subject)
      + row("protocol", r.protocol + " · " + r.cipher)
      + row("SANs", (r.sans || []).slice(0, 8).join(", ")) + "</tbody></table>";
  } else if (st.kind === "compare") {
    const same = r.identical;
    html += '<div class="d">' + (same ? '<span class="pass">identical</span>' : '<span class="fail">' + r.diff_percent + "% different</span>")
      + " — " + esc(r.url_a) + " vs " + esc(r.url_b) + "</div>";
    html += '<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:10px">'
      + [["A", r.a_href], ["B", r.b_href], ["diff", r.diff_href]].map(([lbl, href]) =>
        '<div><div class="d" style="margin-bottom:4px">' + lbl + "</div>"
        + '<a href="' + esc(href) + '" target="_blank"><img src="' + esc(href) + '" style="max-width:230px;border:1px solid var(--separator);border-radius:8px"></a></div>').join("")
      + "</div>";
  } else if (st.kind === "ping") {
    html += '<div class="d"><span class="pass">' + r.up + " up</span>"
      + (r.down ? ' · <span class="fail">' + r.down + " down</span>" : "") + " of " + r.total + "</div>";
    html += '<table class="runs-table" style="margin-top:8px"><tbody>'
      + (r.results || []).map((x) => "<tr><td><span class=\"chip " + (x.ok ? "pass" : "fail") + '">' + (x.status || "ERR") + "</span></td>"
        + "<td>" + esc(x.url) + "</td><td class=\"d\">" + (x.ms != null ? x.ms + "ms" : esc(x.error || "")) + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "screenshot") {
    html += '<div class="d">' + esc(r.url) + " — HTTP " + (r.status || "?") + " · " + esc(r.title || "") + "</div>";
    html += '<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:10px">'
      + (r.shots || []).map((s) => '<div><div class="d" style="margin-bottom:4px">' + esc(s.viewport) + " · " + s.width + "×" + s.height + '</div>'
        + '<a href="' + esc(s.href) + '" target="_blank"><img src="' + esc(s.href) + '" style="max-width:280px;border:1px solid var(--separator);border-radius:8px"></a></div>').join("")
      + "</div>";
  } else if (st.kind === "audit") {
    const checks = r.checks || [];
    const gc = r.grade === "A" ? "var(--status-ok)" : r.grade === "F" || r.grade === "D" ? "var(--status-error)" : "var(--status-warn)";
    html += '<div style="display:flex;align-items:center;gap:14px;margin-bottom:6px">'
      + '<div style="font-size:44px;font-weight:800;line-height:1;color:' + gc + '">' + esc(r.grade || "?") + "</div>"
      + '<div><div style="font-weight:600">Health score ' + (r.score != null ? r.score + "/100" : "") + "</div>"
      + '<div class="d">' + esc(r.url) + " — " + r.pages_audited + " page(s) · "
      + '<span class="fail">' + r.fail_count + " failing</span> · "
      + '<span style="color:var(--status-warn)">' + r.warn_count + " warnings</span></div></div></div>";
    // summary tiles per check
    html += '<div style="display:flex;gap:8px;flex-wrap:wrap;margin:8px 0">'
      + checks.map((c) => { const b = (r.by_check || {})[c] || {}; return '<span class="chip">' + esc(c) + ': '
        + '<span class="pass">' + (b.ok || 0) + "✓</span>"
        + (b.warn ? ' <span style="color:var(--status-warn)">' + b.warn + "!</span>" : "")
        + (b.fail ? ' <span class="fail">' + b.fail + "✗</span>" : "") + "</span>"; }).join("") + "</div>";
    // pages × checks matrix
    html += '<div style="overflow-x:auto"><table class="runs-table"><tbody>'
      + "<tr><td><b>Page</b></td>" + checks.map((c) => "<td><b>" + esc(c) + "</b></td>").join("") + "</tr>"
      + (r.audit_pages || []).map((p) => "<tr><td>" + esc(p.path) + '</td>'
        + checks.map((c) => { const chk = (p.checks || {})[c]; if (!chk) return '<td class="d">–</td>';
          const col = chk.status === "ok" ? "var(--status-ok)" : chk.status === "warn" ? "var(--status-warn)" : "var(--status-error)";
          const iss = (chk.issues || []).join("\n");
          return '<td title="' + esc(iss) + '" style="color:' + col + ';cursor:' + (iss ? "help" : "default") + '">' + esc(chk.status) + "</td>"; }).join("")
        + "</tr>").join("")
      + "</tbody></table></div>";
  } else if (st.kind === "flaky") {
    html += '<div class="d">' + r.runs + " runs · <b class=\"" + (r.flaky_count ? "fail" : "pass") + "\">"
      + r.flaky_count + " flaky test(s)</b></div>";
    html += '<table class="runs-table" style="margin-top:8px"><tbody>'
      + (r.flaky_cases || []).slice(0, 30).map((c) => "<tr><td>"
        + '<span class="chip ' + (c.status === "passed" ? "pass" : "fail") + '">'
        + (c.status === "flaky" ? "FLAKY" : c.status.toUpperCase()) + "</span></td>"
        + "<td>" + esc(c.title) + "</td><td>" + c.passes + "/" + c.runs + " passed</td>"
        + '<td>' + (c.flake_pct ? '<span class="fail">' + c.flake_pct + "% flake</span>" : "") + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "regression") {
    html += '<div class="d">' + (r.baselines_updated ? "baselines updated · " : "") + (r.diffs || []).length + " screenshot(s) compared</div>";
    if (r.diffs && r.diffs.length) {
      html += '<table class="runs-table" style="margin-top:8px"><tbody>'
        + r.diffs.map((d) => "<tr><td>" + esc(d.file) + '</td><td><span class="chip ' + (d.status === "fail" ? "fail" : "pass") + '">' + esc(d.status) + "</span></td><td>" + (d.diff_percent ?? 0) + "%</td><td>"
          + (d.diff_href ? '<a class="rlink" href="' + esc(d.diff_href) + '" target="_blank">diff image</a>' : esc(d.message || "")) + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else {
    html += '<div class="d">' + r.passed + "/" + r.total + " passed"
      + (r.report ? ' · <a class="rlink" href="' + esc(r.report) + '" target="_blank">📄 open report</a>' : "") + "</div>";
    if (r.generated && r.generated.length) {
      html += '<div class="result-files" style="margin-top:6px">' + r.generated.map(esc).join("<br>") + "</div>";
    }
    html += caseTable(r.cases);
  }
  if (r.report) html += downloadRow(r.report);
  else if (st.kind && !st.error) html += '<div class="dl-row"><button class="dl-btn" id="btn-rerun">⟳ Rerun</button></div>';
  panel.innerHTML = html;
  panel.style.display = "block";

  // wire result-panel controls
  const failsOnly = document.getElementById("fails-only");
  if (failsOnly) failsOnly.addEventListener("change", () => {
    for (const row of document.querySelectorAll("#case-table .case-row")) {
      row.style.display = (failsOnly.checked && !row.classList.contains("is-fail")) ? "none" : "";
    }
  });
  for (const b of panel.querySelectorAll(".copy-btn")) {
    b.addEventListener("click", () => {
      navigator.clipboard.writeText(decodeURIComponent(b.dataset.copy || "")).then(() => toast("copied", true, "error copied to clipboard"));
    });
  }
  const rerun = document.getElementById("btn-rerun");
  if (rerun) rerun.addEventListener("click", async () => {
    const res = await fetch("/api/dashboard/jobs/rerun", { method: "POST" });
    if (res.status === 409) { toast("rerun", false, "a job is already running"); return; }
    $("job-result").style.display = "none";
    sync();
  });
}

/* fast 2s status poll while a job is running, so the live log streams */
let busyPoll = null;
function ensureBusyPoll(busy) {
  if (busy && !busyPoll) {
    busyPoll = setInterval(async () => {
      try {
        const st = await fetch("/api/dashboard/jobs/status").then((r) => r.json());
        renderRunStatus(st);
        if (!st.running) {
          clearInterval(busyPoll); busyPoll = null; sync();
          if (videosOpen) loadVideos();
        }
      } catch (e) { /* next tick */ }
    }, 2000);
  } else if (!busy && busyPoll) {
    clearInterval(busyPoll); busyPoll = null;
  }
}

async function sync() {
  try {
    const [overview, pods, runs, runSt] = await Promise.all([
      fetch("/api/dashboard/overview").then((r) => r.json()),
      fetch("/api/dashboard/pods").then((r) => r.json()),
      fetch("/api/dashboard/runs").then((r) => r.json()),
      fetch("/api/dashboard/jobs/status").then((r) => r.json()),
    ]);
    const runList = runs.runs || [];
    renderHero(overview, pods, runList);
    renderWorkloads(overview.workloads);
    renderPods(pods);
    renderRuns(runList);
    renderRunStatus(runSt);
    $("report-link").style.display = overview.report_available ? "inline" : "none";
    $("pdf-link").style.display = overview.pdf_available ? "inline" : "none";
    if (overview.auth && overview.auth.enabled) {
      $("session").style.display = "inline";
      $("session-user").textContent = overview.auth.user;
    }
    await refreshDrawer();
    lastSync = Date.now();
  } catch (err) {
    $("sync").textContent = "sync failed: " + err;
  }
}
setInterval(() => {
  if (lastSync) $("sync").textContent = "synced " + rel((Date.now() - lastSync) / 1000 | 0) + " ago";
}, 1000);

let refreshTimer = null;
function setRefreshRate(ms) {
  if (refreshTimer) clearInterval(refreshTimer);
  refreshTimer = ms > 0 ? setInterval(() => { sync(); if (eventsOpen) loadEvents(); }, ms) : null;
}
$("refresh-rate").value = String(localStorage.getItem("zyvor-refresh") || REFRESH);
$("refresh-rate").addEventListener("change", () => {
  localStorage.setItem("zyvor-refresh", $("refresh-rate").value);
  setRefreshRate(parseInt($("refresh-rate").value, 10));
});
sync();
loadTestHealth();
loadSchedules();
loadFindings();
setInterval(loadSchedules, 15000);
setInterval(loadFindings, 15000);
setRefreshRate(parseInt($("refresh-rate").value, 10) || REFRESH);
</script>
</body>
</html>
